<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GeZi.DownloadEngine</AssemblyName>
    <RootNamespace>GeZi.DownloadEngine</RootNamespace>
    <Product>鸽子下载</Product>
    <AssemblyTitle>鸽子下载</AssemblyTitle>
    <Version>2.4.0</Version>
