<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GeZi.Core</AssemblyName>
    <RootNamespace>GeZi.Core</RootNamespace>
    <Product>鸽子下载</Product>
    <AssemblyTitle>鸽子下载</AssemblyTitle>
    <Version>2.4.0</Version>
    <!-- 与主程序保持一致：统一 x64。
         纯托管库其实 AnyCPU 也能用，但混用位数是 0x8007000B（"格式不正确"）这类
         错误的温床 —— 主程序曾因默认 AnyCPU 而实际以 32 位运行，
         加载 x64 的 WebView2Loader.dll 时直接失败。 -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- PathMap：别让编译机的绝对路径（含用户名）进产物。
         不加 → `C:\Users\<用户名>\Desktop\GeZi\src\...\GeZi.Core.pdb` 被写进 dll
         → 打包发给别人时泄漏本机用户名/目录（本轮实测发现）。详见 GeZi.csproj 里的说明。 -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- 零 NuGet 依赖，可离线编译：JSON 用框架自带 JavaScriptSerializer；HTTP 用 System.Net.Http -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <!-- DPAPI（ProtectedData）加密 Cookie -->
    <Reference Include="System.Security" />
    <!-- 诊断包 zip（ZipArchive） -->
    <Reference Include="System.IO.Compression" />
    <!-- 阿里云盘设备签名（secp256k1）用 BigInteger 做点运算与 recovery id 推导。
         ECDSA 本身交给 ECDsaCng（Windows CNG 原生支持 secp256k1），
         只有「从签名反推公钥点」这一步需要手写模运算。 -->
    <Reference Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ★ 二维码解码：ZXing.Net（Apache-2.0）
      ==================================================================
      夸克分享有时只给一张二维码图片、不给文本链接，
      用户需要把图里的链接抠出来。解码要处理透视校正 + Reed-Solomon 纠错，
      自己写成本远高于编码（QrEncoder 那种），所以用成熟库。

      本项目约定「零 NuGet、离线可构建」。
      因此把 net48 版 zxing.dll（532KB，单文件零依赖）固化进 lib/ZXing/，
      用普通 Reference 引用 —— 任何机器 clone 下来直接 build，不需联网还原。
      详见 lib/ZXing/README.md（含版本 / 许可 / 重新获取方式）。

      ⚠️ net48 下 ZXing 走 System.Drawing 路径，不需要任何 Bindings 包
         （SkiaSharp / Windows.Compatibility 那些只对 .NET 5+ 必要）。
      ⚠️ Private=true 确保 zxing.dll 被复制到输出目录（跟 GeZi.Core.dll 同级）。
      ⚠️ 这里的文件名**刻意用小写 zxing.dll**（与 <AssemblyName>ZXing</AssemblyName> 的大小写不同）：
         GeZi.exe 通过 ProjectReference 拿到它时，MSBuild 会按程序集名规范化成小写 ——
         源码这边跟着写小写，最终产物名才在各平台/打包工具下**完全一致**，
         不会出现"源码是大写、输出是小写"这种大小写不敏感文件系统上才看不出来的坑。
    -->
    <Reference Include="ZXing">
      <HintPath>lib\ZXing\zxing.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- （2026-10-11）原「换 Cookie 辅助脚本 + 内置 CPython」已整体移除 ——
         改用 P/Invoke 直调固化的 OpenSSL 3.5.7（见 lib/OpenSSL 与 Support/OpenSslTls.cs），
         指纹与原来完全一致，但不再需要解释器/脚本/子进程。 -->
  </ItemGroup>

  <ItemGroup>

    <!-- ============================================================
         OpenSSL 3.5.7（2026-10-11 新增）—— 取代内置 CPython 的通道
         ============================================================
         用途：P/Invoke 发**唯一一个**必须过 pan.quark.cn 那道墙的请求
              （扫码登录换登录态 + 取账号昵称/头像）。见 Support/OpenSslTls.cs
              与 Api/PanAccountBridge.cs。

         ⚠️ 为什么必须是这一份、不能换：
             pan.quark.cn 的 ALB 按 TLS ClientHello 的 **supported_groups 扩展大小**
             过滤（阈值约 1600 字节）。实测（2026-10-11，均强制直连）：
               SChannel（.NET / Windows curl）      ❌ RST
               OpenSSL 3.0.18（系统 Python 3.14）    ❌ 连接被强制关闭（约 1500B）
               BouncyCastle 2.7（纯托管 TLS）        ❌
               OpenSSL 3.5.7（本目录这份）           ✅ HTTP 200
             3.5.7 默认启用后量子混合密钥交换（X25519MLKEM768），扩展才够大。

         ⚠️ 必须复制到**输出根目录**：DllImport("libssl-3-x64.dll") 只在 exe 同目录找。
         ⚠️ 是 x64 DLL → 进程必须 64 位（AnyCPU 在 64 位系统上即为 x64）。
         ⚠️ 打包白名单（GeZiTest/package.py 的 KEEP_FILES / deploy.py）要同步这两个文件名！
    -->
    <None Include="lib\OpenSSL\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
