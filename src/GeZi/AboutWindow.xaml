<Window x:Class="GeZi.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关于 鸽子下载"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        「关于」窗口（2026-10-11 重排版）。
        ⚠️ 跟主窗/小窗一样走 WindowChrome（不是分层窗口 → ClearType 正常、文字清晰），
           圆角交给 DWM（见 Loaded 里的 ApplyRoundedCorners）。
        ⚠️ CaptionHeight=44 让标题栏能拖动，里面的关闭按钮要 IsHitTestVisibleInChrome。

        1. **分区卡片化**：品牌 / 更新 / 链接 / 功能 / 说明 / 赞赏 各自成块，
           不再是一大坨纯文字流。
        2. **底部「关闭」固定在 ScrollViewer 外**：内容再长也不会把按钮滚走。
        3. **功能特性改成 2 列小卡**（原来是一列 5 行长文字）。
        4. **新增「更新」卡**：更新包的下载进度显示在**这里**，而不是「下载」页。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
            Background="{DynamicResource AppBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Grid Grid.Row="0" Height="44" Background="Transparent">
                <TextBlock Text="关于 鸽子下载" Margin="20,0,44,0"
                           VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button x:Name="CloseBtn" Click="OnCloseClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="关闭"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Width="30" Height="30"
                        Style="{StaticResource CaptionCloseButton}" ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="11" Height="11"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- ============ 内容（可滚动） ============ -->
            <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                <StackPanel Margin="18,0,18,6">

                    <!-- ① 品牌卡 -->
                    <Border Style="{StaticResource PrimaryCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- logo 本身是白底图 → 深色主题下会顶出一个白方块。
                                 套一个圆角"图标底"把它变成有意的应用图标，两种主题都好看。 -->
                            <Border Grid.Column="0" Width="62" Height="62" CornerRadius="12"
                                    Background="White"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Image Source="/Resources/app-logo.png" Width="54" Height="54"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="鸽子下载" FontSize="20" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <!-- 版本号做成小徽章，比混在标语里清楚 -->
                                    <Border Background="{DynamicResource PrimarySoftBrush}"
                                            CornerRadius="6" Padding="6,1,6,2" Margin="8,2,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="VersionPillText" Text="v?"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="VersionText" Text="多网盘 · 下载器"
                                           FontSize="11" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>

                            <!-- 「检查更新」按钮 + 红点。
                                 ⚠️ 红点用外层 Grid 承载，而不是塞进 Button.Content ——
                                    塞进去会被按钮 Padding 裁掉，还会吃掉点击事件。
                                    IsHitTestVisible=False 保证红点不挡按钮。 -->
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="CheckUpdateBtn" Click="OnCheckUpdateClick"
                                        AutomationProperties.Name="检查更新"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6" FontSize="11"
                                        ToolTip="检查是否有新版本">
                                    <TextBlock Text="检查更新"/>
                                </Button>
                                <Ellipse x:Name="UpdateDot" Width="9" Height="9"
                                         Fill="{DynamicResource DangerBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,-4,-4,0"
                                         IsHitTestVisible="False"
                                         Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ③ 链接：两个并排按钮（原来是两行裸下划线文字）
                         背景透明（GhostButton），与各小窗口按钮一致 -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="RepoBtn" Click="OnRepoClick"
                                AutomationProperties.Name="打开项目开源地址"
                                Style="{StaticResource GhostButton}"
                                Padding="12,6" FontSize="11"
                                ToolTip="在浏览器中打开 GitHub 仓库（源码公开可审计）">
                            <TextBlock x:Name="RepoText" Text="开源地址"/>
                        </Button>
                        <Button x:Name="BiliBtn" Click="OnBiliClick"
                                AutomationProperties.Name="打开作者B站主页"
                                Style="{StaticResource GhostButton}"
                                Padding="12,6" FontSize="11" Margin="8,0,0,0"
                                ToolTip="在浏览器中打开作者 B 站主页">
                            <TextBlock x:Name="BiliText" Text="作者 B 站"/>
                        </Button>
                    </StackPanel>

                    <!-- ④ 功能特性：2 列小卡（由代码填充） -->
                    <TextBlock Text="功能特性" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                    <UniformGrid x:Name="FeatureList" Columns="2"/>

                    <!-- ⑤ 应用简介 + 开源许可：收进一张淡卡，字号压小，别抢主内容 -->
                    <Border Style="{StaticResource MutedCard}" Margin="0,16,0,0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="应用简介" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Style="{StaticResource ProseText}" FontSize="11" Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       Text="一款多网盘分享链接解析与高速下载工具，支持夸克 / UC / 阿里云盘 / 迅雷云盘。粘贴分享链接即可下载，登录后可浏览、转存并下载自己的网盘文件。"/>
                            <TextBlock Style="{StaticResource ProseText}" FontSize="11" Margin="0,6,0,0"
                                       TextWrapping="Wrap"><Run Text="本项目" /><Run
                                        Text="完全开源" FontWeight="SemiBold" /><Run
                                        Text="（AGPL-3.0），源码公开可审计。无广告、无遥测、不收集任何用户数据；登录凭据仅以 Windows DPAPI 加密保存在本机，不会外传。第三方组件许可见仓库内 THIRD-PARTY-NOTICES.md。" /></TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ⑥ 赞赏支持 -->
                    <TextBlock Text="赞赏支持" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                    <Border Style="{StaticResource MutedCard}" Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!-- ⚠️ 用真 Button 而不是 Border+MouseLeftButtonUp：
                                     Border 没有 automation peer，UIA 树里找不到（点不到也测不了）。 -->
                                <Button x:Name="QrBtn" Click="OnQrClick"
                                        Style="{StaticResource IconGhostButton}"
                                        Width="Auto" Height="Auto" Padding="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="赞赏码（点击放大）"
                                        ToolTip="点击放大">
                                    <Border BorderBrush="{DynamicResource BorderBrushSoft}"
                                            BorderThickness="1" CornerRadius="8" Padding="5"
                                            Background="{DynamicResource SurfaceBrush}">
                                        <Image Source="/Resources/reward-qr.png" Width="108" Height="108"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </Button>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="七十鸽 的赞赏码" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="如果觉得好用，欢迎扫码赞赏支持" FontSize="11"
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock Text="点击二维码可放大" FontSize="11"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 底部（固定，不随内容滚动） ============ -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Button x:Name="OkBtn" Content="关闭" Click="OnCloseClick"
                        AutomationProperties.Name="关闭"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" MinWidth="96"/>
            </Border>
        </Grid>
    </Border>
</Window>
