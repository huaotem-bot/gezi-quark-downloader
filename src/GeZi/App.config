<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <!--
      ⚠️ Server GC 已关闭（2026-10-11 回退）。

      【2026-10-02 当初为什么开】想治「CPU 占用非常高」——
      判断是 Workstation GC 的 stop-the-world 暂停在 512 并发下被放大。

      【为什么现在关掉】那个判断**是错的**，而且代价很大：
        ① 真因是 **512 个并发线程的上下文切换**，不是 GC 暂停。
           `docs/CDN并发阈值-实测.md` 已证明**并发拐点在 256**（512 反而更慢），
           正确解法是降并发，而不是换 GC。
        ② Server GC **按 CPU 核建独立堆** —— 本机 16 核 = **16 个堆**，内存直接 ×16。
           实测：9.5GB 文件下到 90 秒，工作集就涨到 **1.36 GB**（此时只下了 14%），
           完整下完会 OOM。当初注释写「对下载器而言内存不是瓶颈」——**被实测推翻**。
        ③ Server GC 优先吞吐、回收更晚 → 长暂停 → 还可能触发下载看门狗误判。

      ⇒ 回到 Workstation GC + 把默认并发降到 256（见 Settings.Threads）。
    -->
    <gcServer enabled="false" />

    <!--
      并发 GC：Gen2 收集与用户线程并行执行，降低长暂停概率。
      （Workstation GC 下本项才真正生效。）
    -->
    <gcConcurrent enabled="true" />

    <!--
      长路径支持（.NET Framework 4.6.2+ 提供开关，Windows 10 1607+ 提供 LongPathsEnabled）。
      app.manifest 里已声明 longPathAware；这里显式关掉旧路径规范化/长路径拦截，
      使 >260 字符的下载目录在系统策略允许时可用（PathUtil 会同时给出预检提示）。
    -->
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
