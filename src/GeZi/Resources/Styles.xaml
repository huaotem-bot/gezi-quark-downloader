<!--
    Styles.xaml —— 通用控件样式
    ============================================================
    规格要求：
      · 字体 Microsoft YaHei UI
      · 数字/速度用 Consolas + TextFormattingMode="Display"（防跳动）
      · 8px 栅格间距：4 / 8 / 12 / 16 / 24 / 32
      · 圆角：卡片 12 / 按钮 8 / 输入框 10 / 徽章 6 / 导航项 8
      · Style 用 StaticResource 引，颜色在 Style 内用 DynamicResource

    注意：net48 的 WPF 有一个已知问题 —— 用 DynamicResource 引用整个 Style
    会失效，所以这里所有 Style 一律 StaticResource 引用；
    颜色/画刷在 Style 内部才用 DynamicResource。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         基础：字体
         ============================================================ -->
    <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, Courier New</FontFamily>

    <!-- 数字文本（速度、大小、百分比）—— 等宽 + Display 模式防抖动 -->
    <Style x:Key="NumericText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ============================================================
         文字层级
         ============================================================ -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="TertiaryText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>

    <!-- ============================================================
         卡片
         ============================================================
         从"1px 描边"改为"极淡阴影 + 更淡的描边"。
         为什么：纯描边卡片在浅底上会有"线框感"，是"生硬"的主要来源之一。
         氛围阴影的参数经验（Fluent / Material 的实际做法）：
           BlurRadius 大（16~28）、ShadowDepth 小（0~2）、Opacity 极低（0.05~0.08）。
         反例：BlurRadius 小 + ShadowDepth 大 = 又脏又硬的"投影边框"。
         ============================================================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                  BlurRadius="22" ShadowDepth="1"
                                  Direction="270" Opacity="0.055"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        重点卡片：设置页/登录页里的"主卡"，阴影略强、内边距更大，
        用来在同页多卡之间制造主次层级（禁止所有卡片等大等重）。
    -->
    <Style x:Key="PrimaryCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                  BlurRadius="28" ShadowDepth="2"
                                  Direction="270" Opacity="0.075"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要卡片：无阴影（"凹陷"到页面底色里），用于并列的辅助信息 -->
    <Style x:Key="MutedCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 徽章（提取码、状态标签等） -->

    <!-- ============================================================
         按钮：主色实心
         ============================================================ -->
    <!-- 主按钮从实心靛蓝改成**深灰底白字**。
         参考 Motrix：全站几乎零彩色，主操作用深色而非品牌蓝。
         保留"唯一实心"的层级（与描边/幽灵按钮区分），只是把颜色从蓝换成中性深灰。
         🚨
            旧话是「TextOnPrimaryBrush 在深色主题下仍是白字，正好复用，不用新增画笔」，
            这句在去蓝改造后**不再成立**：
              · 亮色主题：SolidBtnBg=#1F2430（深底） + SolidBtnFg=#FFFFFF（白字）
              · 深色主题：SolidBtnBg=#E8EAF0（浅底） + SolidBtnFg=#1A1D23（深字）  ← 反过来
            ⇒ 按钮内的图标/文字**一律用 SolidBtnFgBrush**（它就是 Foreground 用的画笔）；
            ⛔ 绝不能写 TextOnPrimaryBrush —— 那个两个主题恒为纯白，画在深色主题的浅灰底上会直接消失
              （用户反馈「下载选中」「获取二维码」的图标看不见，就是这个原因）。 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource SolidBtnFgBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SolidBtnBgBrush}"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 焦点环：默认隐藏，键盘聚焦时才出现（不改变按钮本体几何） -->
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="12"
                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                BorderThickness="2" Visibility="Collapsed"/>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 悬停/按下用中性灰的明暗变化（不再用蓝色系）。
                             BorderStrong 比 TextPrimary 略亮 = 悬停提亮；
                             TextSecondary 更深 = 按下压暗。深浅主题下都是灰阶，不引入彩色。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SolidBtnBgBrush}"/>
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SolidBtnBgBrush}"/>
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <!--
                            Focus 态：此前完全缺失 —— 用键盘 Tab 走一遍，界面上
                            没有任何位置提示，这是无障碍硬伤（WCAG 2.4.7）。
                            做法：用一层 Margin=-3 的外圈 Border 画出"焦点环"。
                            为什么不改内部 Bd 的 BorderThickness：那会让按钮内容
                            整体位移 1~2px（出现肉眼可见的抖动）。外圈独立绘制，
                            按钮本体的几何完全不变。
                        -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         按钮：次要（白底描边）
         ============================================================ -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <!--
            ⚠️ 水平 padding 比 PrimaryButton 少 1px：本样式有 BorderThickness=1，
            左右各多 1px 边框，合计正好补回 16+16 = 15+15+1+1。
            不这样补偿的话，主按钮与次按钮并排时宽度会差 4px（用户截图反馈过）。
        -->
        <Setter Property="Padding" Value="15,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="12"
                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                BorderThickness="2" Visibility="Collapsed"/>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceAltBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         按钮：幽灵（无边框，悬停才显浅底）—— 用于行内操作
         ============================================================ -->
    <!-- ============================================================
         按钮：危险操作（红底实心）—— 删除、清空、不可撤销的动作
         ============================================================ -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="12"
                                BorderBrush="{DynamicResource DangerLightBrush}"
                                BorderThickness="2" Visibility="Collapsed"/>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 悬停/按下：整体降一点不透明度，比再挑一个红色更稳妥 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="12"
                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                BorderThickness="2" Visibility="Collapsed"/>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceAltBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         按钮：工具条小按钮（暂停/恢复/取消等一排）
         ============================================================ -->
    <!-- 工具栏按钮：从"白底描边胶囊"改为**无边框幽灵按钮**。
         改前问题（用户反馈「这几个按钮感觉突兀」）：5 个白底描边按钮排一排，
         **视觉重量完全一样** —— 像 5 个同等重要的操作堆在一起；而实际上
         「暂停全部」是主操作、「打开下载目录」是次要，不该同等对待。
         改后：透明底无边框，**悬停才浮出淡灰圆角块** —— 与面包屑按钮
         （BreadcrumbButton）同一套语言。这也是 Linear / Motrix 的做法：
         工具类操作靠"图标+文字+悬停反馈"表达，不靠常驻边框。 -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceAltBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         面包屑（目录路径条）里**可点击的一节**。
         静止时完全透明 —— 平时看起来就是一段普通文字，不抢视线；
         悬停才浮出一个淡色圆角块、文字转主色。
         与侧栏导航项（NavListItem）的悬停语言一致：同样是
         SurfaceAltBrush 圆角块 + 主色文字，只是更紧凑（12px / 6,2 内边距）。
         ============================================================ -->
    <Style x:Key="BreadcrumbButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- 点完会拿到键盘焦点，不清掉的话会留下一个虚线焦点框（NavListItem 同理） -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceAltBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 面包屑的「当前层」：不可点，主色 + 半粗 —— 与侧栏导航的选中项是同一套语言，
         一眼能看出"你在这里"。内边距与 BreadcrumbButton 对齐，免得整条路径高低不齐。 -->
    <Style x:Key="BreadcrumbCurrent" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================================
         解析历史面板里的一行（整行可点）。
         与 BreadcrumbButton 同一套悬停语言（SurfaceAlt 圆角块 + 主色文字），
         但这里是**整行**：左侧内容自适应拉伸，右侧「打开 →」预留好位置、
         只在悬停时浮出来。用 Opacity 而不是 Visibility —— 否则悬停那一下
         名字会因为可用宽度变化而重新裁剪，看着像闪了一下。
         ============================================================ -->
    <Style x:Key="HistoryRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,1,0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Padding="10,8"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Go" Grid.Column="1" Text="打开 →"
                                       Margin="10,0,2,0" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Opacity="0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceAltBrush}"/>
                            <Setter TargetName="Go" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 解析历史面板里的文字层级：分组标题 / 条目名 / 条目副行 / 空状态 -->
    <Style x:Key="HistoryGroupLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="10,12,0,6"/>
    </Style>

    <Style x:Key="HistoryNameText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <!-- 名称普遍很长（如「行尸走肉 (1-11季全) 附带全系列衍生剧」），必须截断 -->
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="HistoryMetaText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="HistoryEmptyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="10,22,10,26"/>
    </Style>

    <!-- ============================================================
         标题栏按钮（最小化/最大化/关闭，36px 高）
         ============================================================ -->
    <!-- 卡片上的小图标按钮（24×24，只有图标）。
         账号卡那个「刷新」用的：卡片本身是"点进登录页"，所以这个按钮必须
         **小而低调**（默认 tertiary 色、无底色），hover 才浮出一个圆角色块。 -->
    <Style x:Key="IconGhostButton" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <!-- 以前这里没有 Foreground ⇒ 取到默认的深色文字色。
             而 UiBusy.MakeSpinner() 造的加载转圈会**绑定到按钮的 Foreground**，
             于是出现「图标是浅灰、转圈却是深色」的割裂 ——
             用户反馈「左下角那个刷新按钮的转圈和它不是同个颜色」。
             统一给成 TextSecondaryBrush：与 ToolButton 的文字/图标同档。 -->
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- CornerRadius=6 + Margin 内缩：原来是 46×36 贴边的纯方块，
                         用户反馈「整个软件的关闭键都是这么方」。改成圆角并在
                         控件内留 3px 边距，hover 时是一个圆角色块而不是贴边方块。 -->
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Margin="3,3,3,3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource TitleBarHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 关闭键用更大的圆角（圆角方形而非圆形），hover 变红底白叉。
                         尺寸由使用方给（主窗口 46×36，对话框 30×30），
                         Margin 让圆角块在两种尺寸下都不贴边。 -->
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="8" Margin="3,3,3,3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource TitleBarCloseHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         输入框
         ============================================================ -->
    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource SurfaceSunkenBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!--
            ⚠️ 单行输入框必须显式写 Disabled，不能沿用 WPF 默认的 Hidden。
            Hidden 虽然不画出滚动条，但它在布局里**照样占位**（Visibility.Hidden 参与
            测量），ScrollViewer 会白留一条水平滚动条的高度（约 9px）→ 输入框天然高度
            虚高到 47，而一行 13px 的字只需要约 17px。用户反馈的「输入文字显示不全 /
            光标特别小」根因就在这里：多出来的空白把内容区往下推，下伸部（g j p q y）
            被圆角边框裁掉。
            模板里已经把这两个属性 TemplateBinding 给 PART_ContentHost 了，所以
            这里写什么值就真的生效（改模板前是写死默认值，写这行也没用）。
        -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <!-- VerticalAlignment 跟随 VerticalContentAlignment：
                             单行(Center) 垂直居中；多行(Top) 贴顶，内容超高时才出滚动条。
                             写死 Center 的话多行框只有两行内容时会飘到中间。 -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource TextTertiaryBrush}"/>
                        </Trigger>
                        <!-- 聚焦：边框变主色 + 外发光 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#4F6BED" BlurRadius="10"
                                                      ShadowDepth="0" Opacity="0.35"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 多行输入（Cookie 粘贴区） -->
    <Style x:Key="AppTextBoxMultiline" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- 等宽只读日志框 -->
    <Style x:Key="LogTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         下拉框
         ============================================================ -->
    <Style x:Key="AppComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  IsHitTestVisible="False"/>
                                <!-- 下拉箭头 -->
                                <Path Grid.Column="1" Margin="0,0,12,0"
                                      Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextTertiaryBrush}"
                                      StrokeThickness="1.5" VerticalAlignment="Center"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Border>
                        <ToggleButton Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True"
                               Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="10"
                                    Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#1F2430" BlurRadius="16"
                                                      ShadowDepth="2" Opacity="0.14"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="260" Margin="4">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource TextTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉项 -->
    <Style x:Key="AppComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         复选框
         ============================================================ -->
    <Style x:Key="AppCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="6"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                BorderThickness="1.5" VerticalAlignment="Center">
                            <!-- 暗色模式下对勾"根本看不见"：
                                 原来勾写死 Stroke="White"，而选中底色是 TextPrimaryBrush ——
                                 暗色下它是**浅色**（#E8EAF0）→ 白勾画在浅底上直接消失。
                                 改成 SolidBtnFgBrush（与实心按钮前景同一套）：
                                 亮色=白勾配深底、暗色=深勾配浅底，两边都有对比度。 -->
                            <Path x:Name="Tick" Data="{StaticResource IconCheck}"
                                  Stroke="{DynamicResource SolidBtnFgBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Margin="3" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         进度条：6px 圆角，底色 PrimaryLight，填充 Success，200ms 补间
         ============================================================ -->
    <Style x:Key="SlimProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Track" Background="Transparent"/>
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         列表（文件列表 / 任务列表）
         ============================================================ -->
    <!-- 文件列表项：行高 40，悬停浅底，选中左侧 2px 主色竖线 -->
    <Style x:Key="FileListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!--
                        布局要点（两条都是用户实拍反馈修出来的）：
                        ① 高亮块 Bd 必须是**圆角 + 左右留边**，否则它的直角会盖住外层
                           列表卡（Card，CornerRadius=12）的圆角 —— 用户原话
                           「原本是有圆角的但我一选中这个文件它的阴影就把圆角遮住了」。
                        ② 左侧的选中指示条**不要另开一个 Border**，直接用 Bd 自己的
                           「左侧 3px 主色边框」。
                           历轮踩过两次坑：
                             · SelBar 挂在外层 Grid → 比 Bd 高 1px → 圆角外露蓝尖角；
                             · SelBar 挪进内层 Grid 但**加在 Bd 之前** → 同一 Grid 里
                               后加的在上层，不透明的 Bd 把竖线中间整段盖住，
                               只剩上下两端圆角"退让"处露出来 → **两个蓝点**
                               （用户原话「我选中的文件夹的左边有两个蓝点儿」，
                               实测 x=41 列：y46~54 蓝、y55~85 被盖、y86~95 蓝）。
                           ✅ 正解：让 Bd 自己带 BorderThickness="3,0,0,0"，
                              Border 会**沿着 8px 圆角把这条边描成曲线**，
                              天然不可能溢出圆角，也不存在遮挡问题。
                           ③ BorderThickness 恒定（未选中时 Brush=Transparent），
                              这样内容偏移不变；Padding 由 12 减到 9 补偿那 3px。
                    -->
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" Background="Transparent" MinHeight="40"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                CornerRadius="8" Margin="4,1" Padding="9,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceAltBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         「获取直链」弹窗：文件管理器式页签 + 连体列表
         ============================================================
         用户要求「将顶上的这三个按钮变成下面文件夹的三种标签页」，
         并明确选择「顶部文件夹标签」形态 —— 也就是资源管理器那种：
         选中页签是白底、上沿圆角、**底边与下方内容区齐平无缝连成一体**，
         未选中页签是灰底、略微下沉。

         实现分工：
           · TabStripBorder  —— 页签条底部的 1px 分隔线（未选中页签坐在它上面）
           · FileTabItem     —— 单个页签（ToggleButton，圆形选中互斥）
           · TabHostCard     —— 页签条 + 内容区的外框：只圆上面两个角，
                                内容区白底、上边线被选中页签"吃掉"，形成连体感
    -->
    <Style x:Key="TabStripBorder" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrushSoft}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="FileTabItem" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- 页签之间**不留间隙**：相邻页签直接拼在一起，形成一条连续的页签带 -->
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="18,7"/>
        <!-- 页签不做键盘焦点框（弹窗里 Tab 到它反而突兀） -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!--
                        页签观感（用户反馈「这个地方做的感觉好僵硬」后重做）：
                        实测旧版有三处硬伤：
                          ① 每个页签左右各 1px 边框 + 3px 间隙 → 相邻页签之间出现
                             **双竖线**（实测 x=181 与 x=186 两条灰线夹 3px 白），
                             读起来是"三个各自带框的盒子"而不是一条页签带；
                          ② 选中的页签也画整圈边框 → 像按钮不像页签；
                          ③ 未选中填充 SurfaceAlt(249,250,252) 与卡片白(255,255,255)
                             只差 6 个灰阶，肉眼几乎看不出 → 视觉上只剩边框在起作用，
                             机械感就是这么来的。

                        ✅ 现在：**去掉全部边框、去掉间隙**，靠"填充色差"区分状态：
                           · 未选中 → 下沉灰底 SurfaceSunkenBrush，上沿圆角
                           · 悬停   → 再深一档（用 BorderBrushSoft 的灰，比 sunken 深）
                           · 选中   → 纯白底 + **顶部 2px 主色高亮线**
                                      （用 Bd 自己的 BorderThickness="0,2,0,0"，
                                        Border 会沿圆角把这条线描成曲线，不会溢出）
                           · 底边 Margin 下移 1px 吃掉页签条分隔线，与下方列表连体
                        BorderThickness 恒定（未选中时 Brush=Transparent），
                        这样选中/未选中的内容偏移完全一致，文字不会上下跳。
                    -->
                    <Border x:Name="Bd"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0,2,0,0"
                            CornerRadius="8,8,0,0"
                            Padding="{TemplateBinding Padding}"
                            MinWidth="104" MinHeight="34">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource BorderBrushSoft}"/>
                        </Trigger>
                        <!-- 选中：白底 + 顶部主色高亮线 + 主色文字，底边压掉分隔线 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="Margin" Value="0,0,0,-1"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 页签条 + 内容区的外框：上面两角圆、下面两角方，内容区白底无边 -->
    <Style x:Key="TabHostCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
        <Setter Property="BorderThickness" Value="1,0,1,1"/>
        <Setter Property="CornerRadius" Value="0,0,10,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!--
        弹窗里的朴素列表项：圆角高亮 + 悬停，左右留边不糊住外层卡片圆角。
        给「获取直链」这类自绘弹窗用 —— 与 FileListItem 的观感一致，
        但更紧凑（弹窗内容密度高）。
    -->
    <Style x:Key="DialogListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="6" Margin="4,1" Padding="10,0" MinHeight="30">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceAltBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        无装饰的列表行容器 —— `PlainListBox` 的默认 ItemContainerStyle。

        WPF 默认的 ListBoxItem 模板自带两条「系统蓝」：
          · IsSelected  → 蓝底 + 白字（SystemColors.HighlightBrush）
          · IsKeyboardFocusWithin → **1px 浅蓝描边**（ListBoxItemKeyboardFocusVisualBrushKey）
        在这套自绘界面里非常突兀 —— 用户截图反馈「这个选定窗口的蓝边太丑了」，
        而且那圈蓝框是**矩形**，套在圆角行卡片外面，边缘还是错开的。

        行内容自己就是一张完整卡片（背景/描边/圆角/内边距全在行里画），
        所以容器只需要原样呈现内容：纯 ContentPresenter，选中/焦点一律不给任何视觉。
        ⚠️ 别在这里加 Border/Padding —— 行卡片的留白由行自己控制，加了会双重内缩。
    -->
    <Style x:Key="PlainListRow" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- 去掉键盘焦点那圈虚线/蓝框 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        任务行上的「播放 / 暂停」图标按钮（无文字，图标随状态互换）。

        控制**这个下载任务**的暂停 / 恢复 —— 与右键菜单的「暂停 / 恢复」同一套逻辑。
        ⚠️ **不是"控制播放器"**：GeZi 是把文件交给 VLC 等**外部播放器**打开的，
        控制不了外部播放器的播放/暂停；要做那个就得内置播放器，是另一个量级的功能。

        图标：进行中/排队中 → ⏸（点它=暂停）；已暂停 → ▶（点它=继续，同时染成警示黄）。
        终态（完成/失败/已取消）没有暂停恢复的意义 → 整个按钮收起，不占位置。
    -->
    <Style x:Key="TaskPauseButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTip" Value="暂停这个任务"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <Path x:Name="Ico" Data="{StaticResource IconPause}"
                              Stretch="Uniform" Width="11" Height="11"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceAltBrush}"/>
                            <Setter TargetName="Ico" Property="Stroke"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <!-- 已暂停 → 换成播放三角，并染成警示色，一眼看出"点它能继续" -->
                        <DataTrigger Binding="{Binding State}" Value="Paused">
                            <Setter TargetName="Ico" Property="Data"
                                    Value="{StaticResource IconPlay}"/>
                            <Setter TargetName="Ico" Property="Stroke"
                                    Value="{DynamicResource WarningBrush}"/>
                            <Setter Property="ToolTip" Value="继续这个任务"/>
                        </DataTrigger>
                        <!-- 待续传（启动时摆进列表的未完成任务）→ 同样亮 ▶：
                             点它会重新取链并从断点续传（不是暂停恢复的"继续"）。 -->
                        <DataTrigger Binding="{Binding State}" Value="AwaitingResume">
                            <Setter TargetName="Ico" Property="Data"
                                    Value="{StaticResource IconPlay}"/>
                            <Setter TargetName="Ico" Property="Stroke"
                                    Value="{DynamicResource WarningBrush}"/>
                            <Setter Property="ToolTip" Value="继续下载（重新取链，从断点续传）"/>
                        </DataTrigger>
                        <!-- 终态：没有暂停/恢复的意义，收起按钮（Collapsed 不占位） -->
                        <DataTrigger Binding="{Binding State}" Value="Completed">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Cancelled">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 任务列表项（卡片式，高度自适应） -->
    <Style x:Key="TaskListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="12"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            Padding="14,12">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource BorderBrushStrong}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 容器级：关掉 ListBox 默认边框与选中高亮 -->
    <Style x:Key="PlainListBox" TargetType="ListBox">        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         分割线
         ============================================================ -->

    <!-- ============================================================
         诊断面板的表格
         ============================================================
         WPF 的 DataGrid 默认是「系统表格」观感：灰渐变表头 + 蓝底选中格 +
         每格一圈边框。放在这套自绘界面里非常突兀（用户反馈「这个地方的 ui 也太丑了」）。
         这里把表头 / 行 / 单元格全部换成主题令牌：表头是浅灰小字、行无边框、
         悬停浅底、选中用主色浅底，网格线只保留很淡的横向分隔。
    -->
    <Style x:Key="DiagColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <!-- 只用一条很淡的下边框当分隔，不要系统那套立体表头 -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DiagCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- 去掉系统那圈蓝底"当前单元格"高亮（截图里最扎眼的就是它） -->
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DiagRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         右键菜单。
        🚫 **这里刻意不加 DropShadowEffect。**
        曾经在模板的最外层 Border 上加过 BlurRadius=16 / Opacity=0.16 的阴影，
        结果：Popup 的尺寸 == 这个 Border 的尺寸（没留白）→ **阴影被 Popup 窗口裁掉**，
        直线边一个像素都渲染不出来（实测菜单左侧 x=14..29 是纯 AppBgColor (245,246,250)），
        只有**四个圆角**处、Popup 矩形内又没被圆角白底覆盖的那一小块三角区把阴影残留下来
        → 用户看到的就是「四个角有灰色的印子」。
        也就是说那个阴影根本没在当阴影用，只贡献了四个灰印。
        要真正显示阴影，必须给 Popup 留白并允许透明，而 ContextMenu 的 Popup 由框架托管、
        不好控制，性价比太低 —— 所以直接用 1px 描边表达层次，不加 Effect。
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         托盘右键菜单专用：紧凑版 MenuItem
         ============================================================

         ⚠️ 不能复用下面那个隐式 MenuItem 样式：它带一个**固定 22px 的图标列**
            （右键任务行 / 文件列表时用来对齐图标），而托盘菜单四项**都没有图标** ——
            那 22px 图标列 + 8px Margin 就变成左侧一大块空白；
            再加上 Header 列是 `*`（填满），右侧又留一截，菜单看起来"左右都空"。
         托盘菜单只有纯文字，用这个不带图标列的紧凑模板。 -->
    <Style x:Key="TrayMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- 新增图标列（固定 22px，保证各菜单项文字左对齐） -->
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 图标：14px 线性图标；未设 Icon 的项该列留空，文字仍对齐 -->
                            <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="20,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrushSoft}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        🚨🚨 **菜单里的分隔条必须用这个带 key 的样式**（2026-10-04 实测踩坑）

        WPF 的 ContextMenu 对**菜单内**的分隔条不用隐式样式，而是用挂在
        `MenuItem.SeparatorStyleKey` 上的内部样式 —— 默认是 `#FFD7D7D7` 系统浅灰，
        深色模式下就是**一条刺眼的白横线**（用户截图反馈）。
        实测（`tmp-links` 的 `traymenu-probe` 真弹菜单后读 Separator 实例）：
          · 不显式设 Style → Background=#FFD7D7D7  ❌
          · 显式设 Style   → Background=#FF333844  ✅
        并且**试过**在 Application.Resources 里覆盖 `MenuItem.SeparatorStyleKey`，**无效**。
        → 所以凡是写在 `<ContextMenu>` / 菜单里的 `<Separator/>`，都要挂这个 Style。
        （托盘菜单是代码建的，TrayIcon.BuildMenu 里也显式套了同一个样式对象。）
    -->
    <Style x:Key="MenuSeparator" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}"/>

    <!-- ============================================================
         内容区（原「左侧导航 + 右侧内容」TabControl，2026-10-02 拆分）
         ============================================================
         设计取舍：MainWindow 的 code-behind 里大量使用
         `Tabs.SelectedIndex = n` 切换页面（登录跳转、下载后跳任务页等）。
         为了「只换皮肤不动逻辑」，这里**保留真实 TabControl**，
         但只让它负责**内容区** —— 左侧导航改由 MainWindow.xaml 里的
         独立 ListBox 承担，两者用 SelectedIndex 双向同步。

         为什么必须搬出来（不是审美问题，是硬的编译约束）：
         ControlTemplate 里的 `x:Name` **不是**类的字段。上一轮把
         AccountText / CapacityText 放进这个模板的侧栏里，直接导致
         `CS0103: 当前上下文中不存在名称"AccountText"`（6 处）。
         侧栏里有账号卡，账号卡要被 code-behind 读写，就必须待在
         真实可视树里。所以侧栏整体搬出模板。

         ⚠️ 内容呈现的坑（已实测）：
         WPF 的 TabControl **不通过 SelectedContent 呈现内容**，
         而是让**每个 TabItem 自己的模板**用 ContentPresenter 呈现 Content。
         所以在 TabControl 模板里放 `ContentPresenter ContentSource="SelectedContent"`
         会拿到空内容（UIA 里内容区整棵子树消失）。
         正确做法：TabControl 模板里只放 ItemsPresenter 的宿主，
         内容由 TabItem 模板里的 ContentPresenter 负责。
         ============================================================ -->
    <Style x:Key="NavTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Border Background="{DynamicResource AppBgBrush}">
                        <!--
                            ⚠️ 关键点（实测出来的三条）：
                            1. ItemsPresenter 必须存在，否则 TabItem 不被实例化。
                            2. **不能**再放 `ContentPresenter ContentSource="SelectedContent"`：
                               内容由 TabItem 自己的模板呈现。多放一个会让每个页面
                               被渲染两遍（UIA 里能看到重复的文本节点）。
                            3. ItemsPanel 换掉默认的 TabPanel：TabPanel 是给
                               "横排页签条"用的，它会把 TabItem 排到内容区之外
                               （实测报出 y=-20，即窗口上方不可见区）。
                               用 Grid 让唯一的可见 TabItem 铺满整个内容区。
                        -->
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         内容区页签（TabItem）—— 导航已搬到侧栏 ListBox，页签头完全不画
         ============================================================
         为什么不能直接把 TabItem 删掉换成 ContentControl：
         code-behind 里有 6 处 `Tabs.SelectedIndex = n`，以及 SelectedItem /
         SelectionChanged 语义。保留 TabControl + 4 个 TabItem 最省事。

         ⚠️ 三个必须点（都是实测踩出来的）：
         1. 模板里要放 `<ContentPresenter ContentSource="Content"/>` ——
            WPF 的 TabControl 不负责呈现内容，内容由**每个 TabItem 自己的模板**
            呈现。不放心会内容区整棵消失。
         2. **不能**画 Header 的 ContentPresenter —— 页签头要完全不可见。
         3. **必须**自己写 `IsSelected=False → Visibility=Collapsed`：
            通常这件事是 TabPanel 干的（它只显示选中项），但我们在
            NavTabControl 里为了"内容铺满"把 ItemsPanel 换成了 Grid，
            于是没人再做隐藏 —— 4 个页面会叠在同一坐标全部渲染
            （实测：UIA 里 4 个页面都在 (221,37)、都报 off=0）。
         ============================================================ -->
    <Style x:Key="HeadlessTabItem" TargetType="TabItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter ContentSource="Content"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="Bd" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        侧栏导航项（ListBoxItem）—— 与旧的 NavTabItem 视觉一致，
        但换成 ListBox 承载，这样它就在真实可视树里，且不必再跟
        TabControl 的 ItemsPanel/TabPanel 语义纠缠。

        ⚠️ 关于"选中淡蓝底比按钮大一圈、圆角也不对"：
        根因是**焦点环在鼠标点击时也亮起**。ListBoxItem 被鼠标点中后
        IsKeyboardFocused 同样为 True，于是内层 Bd（选中底，圆角 8）
        与外层 FocusRing（Margin=2、圆角 10）同时出现，两层叠在一起，
        视觉上就是"蓝底外面又套了一圈，圆角还对不上"。
        正解：焦点环是**键盘导航专用**的无障碍提示，鼠标操作不该出现。
        做法：仅在 IsKeyboardFocused=True **且** IsMouseOver=False 时显示
        （键盘 Tab 过去时鼠标不在该项上；鼠标点击时必然在）。
    -->
    <Style x:Key="NavListItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1,0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- 关掉系统默认焦点虚线框，用我们自己的 FocusRing -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <!--
                                     三层叠加替代原来的"整块换底色"：
                                     ① SelBg   选中底色（SurfaceSunken 浅灰）
                                     ② HoverBg 悬停底色（SurfaceAlt，叠在选中层之上，
                                                所以选中项悬停时显示的是悬停色）
                                     ③ RippleHost 波纹画布（RippleEffect.cs 动态加椭圆，
                                                裁到圆角；必须位于底色之上、内容之下）
                                     两层底色平时 Opacity=0，由触发器做透明度过渡 ——
                                     硬切底色是"生硬感"的根源，150ms 淡入淡出即可消掉。 -->
                                <Border x:Name="SelBg" CornerRadius="8" Opacity="0"
                                        Background="{DynamicResource SurfaceSunkenBrush}"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="HoverBg" CornerRadius="8" Opacity="0"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        IsHitTestVisible="False"/>
                                <Canvas x:Name="RippleHost" ClipToBounds="True"
                                        IsHitTestVisible="False"/>
                                <!-- 选中：左侧 3px 指示竖条（淡入淡出，不再硬弹）。
                                     从主色蓝改成 TextPrimary（深灰/黑）——
                                     蓝色只留给 Logo。指示性靠这条深色竖线 + 底色 + 粗体共同表达。 -->
                                <Border x:Name="SelBar" Width="3" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="2,7"
                                        Opacity="0"
                                        Background="{DynamicResource TextPrimaryBrush}"
                                        Visibility="Collapsed"/>
                                <ContentPresenter Margin="14,10" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- 焦点环：与 Bd 同几何（不设 Margin），只用描边区分，
                             避免出现"外面套一圈更大的框" -->
                        <Border x:Name="FocusRing" CornerRadius="8"
                                BorderBrush="{DynamicResource TextPrimaryBrush}"
                                BorderThickness="1.5" Visibility="Collapsed"
                                IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：底色淡入 150ms（先快后慢）/ 淡出 120ms。
                             文字色与字重不参与过渡 —— 纯文字的瞬间切换反而利落，
                             且 Foreground 在触发器和内容绑定上同时生效，动画它容易打架。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 选中：底色平滑过渡 180ms + 竖条淡入；文字加粗瞬间（见上）。
                             选中底色从 PrimaryLightBrush（淡蓝块）
                             改成 SurfaceSunkenBrush（中性浅灰）。
                             为什么：白底 + 淡蓝选中块 + 蓝色图标是"模板化 UI"的典型配方，
                             用户一眼就认出"模板感"。改成中性灰后，蓝色只出现在左侧那条
                             3px 竖线上 —— 克制、有指示性、不抢戏（VSCode / Linear 的做法）。
                             文字用 TextPrimary + SemiBold 表达"被选中"，不再靠变蓝。 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelBg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelBar"
                                                                       Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                Value="{x:Static Visibility.Visible}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelBg"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelBar"
                                                                       Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                Value="{x:Static Visibility.Collapsed}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <!--
                            键盘焦点环：多加一个 IsMouseOver=False 条件。
                            单靠 IsKeyboardFocused 会在鼠标点击后也亮起（就是那个 bug）。
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="IsMouseOver" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 导航项内部：图标 + 文字 -->
    <Style x:Key="NavItemIcon" TargetType="Path">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stroke" Value="{Binding Foreground,
                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
        <Setter Property="StrokeThickness" Value="1.9"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <Style x:Key="NavItemText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="11,0,0,0"/>
        <Setter Property="Foreground" Value="{Binding Foreground,
                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
    </Style>

    <!-- 侧栏导航容器：无边框、无滚动条、不虚拟化（只有 4 项） -->
    <Style x:Key="NavListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         账号卡（侧栏左下角）
         ============================================================
         取代原来挤在标题栏右侧的「已登录: 已登录用户 | 容量: 3.99 GB / 10.04 GB」。
         参考 Motrix / qBittorrent：账号与状态属于"全局身份信息"，
         固定放在侧栏底部；容量用进度条而不是一串数字 —— 数字要读，
         进度条一眼就知道。占用率越高颜色越警示（状态色编码）。
         ============================================================ -->
    <!-- 头像底色从 PrimaryBrush（实心蓝圆）改成
         SurfaceSunkenBrush（中性浅灰圆）+ 文字 TextPrimary。
         为什么：左下角一个实心蓝圆是整页最抢眼的色块，但账号卡的重要性排不上号
         （"AI味"诊断里指出"控件比例失调"）。改成中性后蓝色彻底从侧栏区域消失，
         只留在该用的地方（主按钮、聚焦态、选中竖线）。 -->
    <Style x:Key="AvatarBorder" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 容量条：极细（2px），底色凹陷，填充色由 code-behind 按占用率给
         4px → 2px：账号卡是全页最不该抢戏的元素，进度条做成一条细线。
         ⚠️ **填充色保留三色语义编码**（CapacityLow/Mid/High = 绿/黄/红，越满越警示），
         这里 Foreground 只是默认值，实际由 code-behind 覆盖 —— 别改成固定绿。 -->
    <Style x:Key="CapacityBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="1"/>
                        <Border x:Name="PART_Track" Background="Transparent"/>
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         分段单选（RadioButton 重写为胶囊式分段控件）
         ============================================================
         用于「分享链接 / 我的网盘」模式切换：外框浅底，选中项白底漂浮。
         ============================================================ -->
    <Style x:Key="SegmentedRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="18,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 选中 = 深色粗体字。**底色不再由 RadioButton 自绘**——
                                 2026-10-17 改走 SegmentedSlider 滑块（整段面板共用一个滑块滑到选中项），
                                 这里只负责文字态，避免滑块滑到后选中态"双重背景"。 -->
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         任务页顶部筛选（全部 / 进行中 / 已完成）
         ============================================================

         ⚠️ 用 RadioButton 而不是 TabItem：4 个分类**共用同一个任务列表**
            （只切换过滤器），用 TabItem 就得放 4 份列表副本 —— 状态会不同步。
         视觉与设置页的 Tab 保持一致（下划线式、深灰而非蓝）。 -->
    <Style x:Key="FilterTabRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0,0,0,7"/>
        <Setter Property="Margin" Value="0,0,24,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 选中 = 深色粗体字。**下划线不再由 RadioButton 自绘**——
                                 2026-10-17 改走 SegmentedSlider 滑块（Height=2 的指示条在筛选项间滑动），
                                 模板上保留透明底边框占位保证布局高度不跳。 -->
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         提示条
         ============================================================ -->

    <Style x:Key="InfoBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ============================================================
         加载态（2026-10-02 新增）
         ============================================================
         为什么要这个：原来文件列表只有"空状态"一种非内容状态。
         加载目录的几百毫秒里列表是空的 → 空状态插画就跳出来喊"还没有内容"，
         用户以为没数据，其实正在加载。这是**误导**，不是审美问题。
         现在拆成三种互斥状态：加载中 / 空 / 有内容。
         ============================================================ -->
    <Style x:Key="LoadingSpinner" TargetType="Path">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 稀疏说明文字：收窄行宽到 ≤75 字符等效宽度，长段落不再横贯整屏 -->
    <Style x:Key="ProseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="MaxWidth" Value="520"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- 设置页字段标签（统一列宽，避免各行文字基线不齐） -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <!-- 设置页分组小标题（卡片内的一级小节，弱于 CardTitleText） -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

</ResourceDictionary>
