<!--
    分段控件 / 过滤页签 / 提示条 / 加载 / 说明文字
    ============================================================
    本文件是原 Styles.xaml（1930 行）按职责拆出的资源字典之一（2026-10-24 代码规范化）。
    拆分原则：只按行区间搬运，成员文本一字未改；App.xaml 的合并顺序与拆分前一致。

    规格要求（全项目通用，详见 Styles.Typography.xaml 头部）：
      · 字体 Microsoft YaHei UI
      · 数字/速度用 Consolas + TextFormattingMode="Display"（防跳动）
      · 8px 栅格间距：4 / 8 / 12 / 16 / 24 / 32
      · 圆角：卡片 12 / 按钮 8 / 输入框 10 / 徽章 6 / 导航项 8
      · Style 用 StaticResource 引，颜色在 Style 内用 DynamicResource
-->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">


    <!-- ============================================================
         分段单选（RadioButton 重写为胶囊式分段控件）
         ============================================================
         用于「分享链接 / 我的网盘」模式切换：外框浅底，选中项白底漂浮。
         ============================================================ -->
    <Style x:Key="SegmentedRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="18,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 选中 = 深色粗体字。**底色不再由 RadioButton 自绘**——
                                 2026-10-17 改走 SegmentedSlider 滑块（整段面板共用一个滑块滑到选中项），
                                 这里只负责文字态，避免滑块滑到后选中态"双重背景"。 -->
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         任务页顶部筛选（全部 / 进行中 / 已完成）
         ============================================================

         ⚠️ 用 RadioButton 而不是 TabItem：4 个分类**共用同一个任务列表**
            （只切换过滤器），用 TabItem 就得放 4 份列表副本 —— 状态会不同步。
         视觉与设置页的 Tab 保持一致（下划线式、深灰而非蓝）。 -->
    <Style x:Key="FilterTabRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0,0,0,7"/>
        <Setter Property="Margin" Value="0,0,24,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 选中 = 深色粗体字。**下划线不再由 RadioButton 自绘**——
                                 2026-10-17 改走 SegmentedSlider 滑块（Height=2 的指示条在筛选项间滑动），
                                 模板上保留透明底边框占位保证布局高度不跳。 -->
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         提示条
         ============================================================ -->

    <Style x:Key="InfoBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ============================================================
         加载态（2026-10-02 新增）
         ============================================================
         为什么要这个：原来文件列表只有"空状态"一种非内容状态。
         加载目录的几百毫秒里列表是空的 → 空状态插画就跳出来喊"还没有内容"，
         用户以为没数据，其实正在加载。这是**误导**，不是审美问题。
         现在拆成三种互斥状态：加载中 / 空 / 有内容。
         ============================================================ -->
    <Style x:Key="LoadingSpinner" TargetType="Path">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 稀疏说明文字：收窄行宽到 ≤75 字符等效宽度，长段落不再横贯整屏 -->
    <Style x:Key="ProseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="MaxWidth" Value="520"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- 设置页字段标签（统一列宽，避免各行文字基线不齐） -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <!-- 设置页分组小标题（卡片内的一级小节，弱于 CardTitleText） -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>


    <!-- ══════════════════════════════════════════════════════════════════
         分组头展开/折叠按钮（2026-11-01）
         ══════════════════════════════════════════════════════════════════
         用户反馈：「展开按钮和折叠按钮太丑，请只优化这两个按钮的视觉样式」。

         根因：项目从未给 Expander 写过样式，用的是 **WPF 默认模板** ——
         它自带一个灰色圆底 + 三角箭头的 ToggleButton，是 2005 年 WinForms 的观感，
         和这套自绘界面完全不在一个体系。

         现在换成现代做法：
           · 去掉圆形底，只留一根**细箭头**（与 Icons.xaml 的描边风格一致）；
           · 展开时箭头旋转 90°（▸ → ▾），这是 macOS / VS Code / Linear 的通行做法；
           · 悬停给一点极淡底色，圆角 4px，不喧宾夺主；
           · 整块 20×20 命中区，视觉上只有 9px 箭头，点击仍然好点。

         ⚠️ 只覆盖 ToggleButton 这一段，Expander 的内容区（ItemsPresenter）
            与分组头的文字/图标/徽章一律不动 —— 用户明确要求"只优化这两个按钮"。
         ⚠️ 别在这里加 Background 到 Expander 本身，会盖住整行。
    -->
    <Style x:Key="GroupExpanderToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                        <!-- 2026-11-01 修复：这里原来**只有箭头**，没有 ContentPresenter，
                             而 GroupExpander 的 HeaderSite 又绑了 Content={TemplateBinding Header}
                             → 分组头的文字/图标/条数徽章全都不渲染，只剩一个孤立箭头。
                             现在改成「箭头 + 内容」横向排列。 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 箭头：默认朝右（收起），Checked 时旋转 90° 朝下（展开）。
                             几何用「V 形折线」而不是实心三角 —— 实心三角在 9px 尺寸下
                             会糊成一团，细线更清爽。 -->
                        <Path x:Name="Arrow"
                              Data="M4,2 L8,6 L4,10"
                              Stretch="Uniform" Width="8" Height="8"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource TextTertiaryBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="ArrowRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                            <ContentPresenter Margin="6,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 展开 → 箭头转 90° 朝下。
                             ⚠️ RotateTransform 不是元素，不能用 TargetName 指向它（MC4111），
                             所以整个 RenderTransform 一起替换。 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- 悬停：极淡底色，让人知道这里能点 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource SurfaceAltBrush}"/>
                            <Setter TargetName="Arrow" Property="Stroke"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Expander 本身：去掉默认模板里的圆圈按钮，只保留「箭头 + 内容」 -->
    <Style x:Key="GroupExpander" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <!-- ⚠️ ToggleButton 的 Width/Height 在 GroupExpanderToggle 里写死了 20，
                             但这里要放「箭头 + 分组标题」，所以必须覆盖成 Auto。
                             不覆盖的话标题会被裁在 20px 里，看起来像"标题没了"。 -->
                        <ToggleButton x:Name="HeaderSite"
                                      Style="{StaticResource GroupExpanderToggle}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                      HorizontalAlignment="Left"
                                      Margin="0,1,0,1"
                                      Width="Auto" Height="Auto"
                                      Padding="2,1"
                                      Content="{TemplateBinding Header}"/>
                        <ContentPresenter x:Name="ExpandSite"
                                          Visibility="Collapsed"
                                          Focusable="False"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ══════════════════════════════════════════════════════════════
         设置页「分区式」布局（2026-11-02 结构性重设计）
         ══════════════════════════════════════════════════════════════
         用户反复反馈「设置页特别丑」，并明确授权大改。

         旧方案是「6 张卡片分两列堆叠」，本质问题是：
           · 卡片自带阴影 + 12px 圆角 + 18px 内边距 → 视觉噪音大、密度低；
           · 两列高度天然不齐 → 短列底部永远有空；
           · 每张卡里再套 Grid，标签列固定 120px → 左侧大片空白。

         新方案学 Chrome / VS Code / Notion 的**单列分区式**：
           · 没有卡片，只有「分区标题 + 设置行 + 极淡分隔线」；
           · 单列居中，彻底消灭"哪列短"；
           · 行式布局：标签在左、控件在右，中间弹性空白；
           · 分隔线只在分区之间出现（1px，BorderBrushSoft），行与行之间靠留白。
    -->

    <!-- 设置分区容器：**没有**圆角、阴影、内边距 —— 这是"去卡片化"的核心。
         分区之间靠 SettingsDivider 分隔，而不是靠卡片边界。 -->
    <Style x:Key="SettingsSection" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 分区标题：比 CardTitleText 更弱，只做"分组提示" -->
    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <!-- 2026-11-02：12 → 13px。大厂设置页的分组标题通常比正文小一号、
             但比"说明文字"大一号，13px + SemiBold + 三级色正好卡在中间。 -->
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- 分区之间的分隔线 -->
    <Style x:Key="SettingsDivider" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Margin" Value="0,20,0,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 设置行：标签(自适应) + 控件(*) -->
    <Style x:Key="SettingsRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>


    <!-- ══════════════════════════════════════════════════════════════
         设置页卡片（2026-11-02 视觉重设计）
         ══════════════════════════════════════════════════════════════
         上一轮我把卡片全删了（「去卡片化」），结果变成「一堆字段堆在灰底上」，
         完全没有视觉分层 —— 那是**过度纠正**。
         Windows 11 设置页是**有卡片**的：白底、圆角、极淡描边，靠卡片形成模块边界。
         所以这里把卡片加回来，但比原来的 Card 更轻（无阴影、描边更淡）。
    -->
    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 分区标题：带图标的一行（图标由调用方用 Path 画，这里只管文字） -->
    <Style x:Key="SettingsCardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ==============================================================
         设置行三栏布局（2026-11-02 第三次重做）
         ==============================================================
         前两次失败的原因：
           1) 第一次：两列 Grid 行对齐 -> 同行两卡被拉成等高，矮卡下方留整行空洞；
           2) 第二次：还是 Grid 行对齐，只是改了间距 -> 空洞照旧。
         这次换成**单列 + 每行三栏**（Windows 11 设置页的真实结构）：
           [标签 200px 固定] [控件 * 吃满] [说明 Auto 右对齐]
         为什么是固定 200px 标签列：标签列若用 Auto，每一行宽度都不同，
         控件左边缘就会参差不齐（用户截图里正是这个问题）。
         !! 说明列必须放**同一行**，不能再像原来那样用 Margin="120,0,0,0" 硬缩进 ——
            那个 120 是照 160 宽标签算的，标签一改就全歪。
    -->
    <Style x:Key="SettingsRow3" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!-- 标签：三栏布局专用（与 FieldLabel 的区别是垂直居中 + 不加底边距） -->
    <Style x:Key="SettingsRowLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 说明文字：跟在控件右侧同一行，不再用 Margin 硬缩进 -->
    <Style x:Key="SettingsRowHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="16,0,0,0"/>
        <Setter Property="MaxWidth" Value="260"/>
    </Style>

    <!-- ==============================================================
         普通单选按钮（2026-11-03 新增）
         ==============================================================
         设置页「落盘方式」需要二选一，而项目里原来只有 SegmentedRadio（分段控件）
         和 FilterTabRadio（筛选标签），都不适合「选项 + 说明」这种形态。
         这里给一个最朴素的单选：圆点 + 文字，跟随主题色。
    -->
    <Style x:Key="AppRadioButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Outer" Width="16" Height="16"
                                     Stroke="{DynamicResource BorderBrushStrong}" StrokeThickness="1.4"
                                     Fill="Transparent"/>
                            <Ellipse x:Name="Inner" Width="8" Height="8"
                                     Fill="{DynamicResource TextPrimaryBrush}"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Outer" Property="Stroke"
                                    Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Stroke"
                                    Value="{DynamicResource TextSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分区卡片的标题行（图标 + 标题 + 右上角附加内容） -->
    <Style x:Key="SettingsCardHeader" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

</ResourceDictionary>
