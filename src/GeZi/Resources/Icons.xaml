    <Geometry x:Key="IconCloudOff">M10.94,5.274 A7,7 0 0 1 15.71,10 L17.5,10 A4.5,4.5 0 0 1 21.722,16.057 M18.796,18.81 A4.5,4.5 0 0 1 17.5,19 L9,19 A7,7 0 0 1 5.79,5.78 M2,2 L22,22</Geometry>
    <Geometry x:Key="IconSparkle">M12.000,0.400 C13.276,8.172 15.828,10.724 23.600,12.000 C15.828,13.276 13.276,15.828 12.000,23.600 C10.724,15.828 8.172,13.276 0.400,12.000 C8.172,10.724 10.724,8.172 12.000,0.400 Z M19.600,0.700 C20.030,3.710 20.890,4.570 23.900,5.000 C20.890,5.430 20.030,6.290 19.600,9.300 C19.170,6.290 18.310,5.430 15.300,5.000 C18.310,4.570 19.170,3.710 19.600,0.700 Z M4.600,15.400 C5.220,17.540 6.460,18.780 8.600,19.400 C6.460,20.020 5.220,21.260 4.600,23.400 C3.980,21.260 2.740,20.020 0.600,19.400 C2.740,18.780 3.980,17.540 4.600,15.400 Z</Geometry>

