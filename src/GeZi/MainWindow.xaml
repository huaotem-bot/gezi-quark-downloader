                                        </StackPanel>
                                    </Border>
                                    <!-- ③ 窗口与后台 -->
                                    <Border Grid.Row="2" Style="{StaticResource SettingsCard}"
                                            Margin="0" HorizontalAlignment="Stretch">
                                        <StackPanel>
                                            <Grid Style="{StaticResource SettingsCardHeader}">
