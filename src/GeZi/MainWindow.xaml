                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconActivity}" Stretch="Uniform"
                                                          Width="16" Height="16" VerticalAlignment="Center"
                                                          Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.7"/>
