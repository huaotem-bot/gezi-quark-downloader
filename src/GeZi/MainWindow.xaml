<Window x:Class="GeZi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeZi"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="鸽子下载 · 多网盘下载器"
        Icon="/Resources/app.ico"
        Height="780" Width="1240" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="OnMainKeyDown"
        Closing="OnWindowClosing">

    <!-- 自绘标题栏：去掉系统边框，改用 WindowChrome 保留拖拽/贴边/双击最大化/系统菜单 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- 主题切换「圆形揭示」：旧画面垫底，真实界面加圆形 Clip 盖在上面。
         这样圆外露旧图、圆内是**实时的新 UI** —— 分段控件的滑块能继续滑，不被快照冻住。 -->
    <Grid>
        <Image x:Name="ThemeOldSnapshot" Stretch="Fill" IsHitTestVisible="False"
               Visibility="Collapsed"/>
        <Border x:Name="RootBorder" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= 标题栏 ================= -->
            <Border Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource TitleBarBrush}"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <!-- 按用户要求标题栏**只留文字、不要图标**：
                             「这里我决定不要图标了只要文字」。
                             （窗口/任务栏图标仍是应用图标，那是 Window.Icon，与这里无关。） -->
                        <TextBlock Text="鸽子下载" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!--
                        账号 / 容量已迁到侧栏左下角（见下方 AccountCard）。
                        标题栏只留品牌 + 窗口按钮，避免"一进程序先被一串数字糊脸"。
                    -->

                    <!-- 窗口按钮（WindowChrome.IsHitTestVisibleInChrome 让它们在可拖拽区仍可点击） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}"
                                AutomationProperties.Name="最小化"
                                Click="OnMinimizeClick" ToolTip="最小化">
                            <Path Data="{StaticResource IconMinimize}" Stretch="Uniform" Width="12" Height="12"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButton}"
                                AutomationProperties.Name="最大化或还原"
                                Click="OnMaximizeClick" ToolTip="最大化 / 还原">
                            <Path x:Name="MaxIcon" Data="{StaticResource IconMaximize}" Stretch="Uniform"
                                  Width="11" Height="11"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseButton}"
                                AutomationProperties.Name="关闭窗口"
                                Click="OnCloseClick" ToolTip="关闭">
                            <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="12" Height="12"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 主体：左导航 + 右内容 =================
                 侧栏从 TabControl 的 ControlTemplate 里搬出来了（原因见 Styles.xaml 注释）：
                 模板内的 x:Name 不是类字段，账号卡必须待在真实可视树才能被 code-behind 访问。
                 分隔方式改为「底色差」：侧栏白、内容区浅灰（AppBg），
                 不再画 0,0,1,0 的 1px 硬线 —— 硬线正是"生硬"的来源。
            -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ 侧栏 ============ -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 品牌区 -->
                            <RowDefinition Height="*"/>      <!-- 导航 -->
                            <RowDefinition Height="Auto"/>   <!-- 多选提示 -->
                            <!-- 2026-11-01：账号卡那行已随 AccountCard 一起删除，
                                 多余的空 Auto 行会让底部多出一块留白。 -->
                        </Grid.RowDefinitions>

                        <!-- 品牌区（右边带一个「?」关于按钮 —— 用户要求「在右边增加一个圆圈里边有个？的关于按钮」） -->
                        <StackPanel Grid.Row="0" Margin="20,18,20,14">
                            <StackPanel Orientation="Horizontal">
                        <!-- 品牌 Logo：用真实应用图标（衔橄榄枝的鸽子）。
                             图标本身是"浅底圆角方块 + 深色鸽子"，自带透明圆角，
                             所以不再需要外面那层蓝色底 + 白色线稿箭头。 -->
                        <Image Source="/Resources/app-logo.png" Width="30" Height="30"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <!-- 「鸽子下载」这一行右边紧跟一个「?」关于按钮。
                                         ⚠️ 用户第一版把它做成了 26px 并被 Grid 推到侧栏最右边，
                                         反馈「这个圆圈加？的图标也太大了，直接在这里的鸽子下载的
                                         右边有一个这个图标，图标大小合适不会看着特别大也不会特别小」。
                                         所以：**贴着标题文字放**（不再用 Grid 撑到右边缘）。
                                         之后用户又说「还是有点大了再缩小一点」→ 圆 15→13、外层 20→18。
                                         再之后用户指出「这个？有点偏左，你不会是自己画的吧，
                                         在 ui 库里边找个类似的放在这里」→ 弃用「Ellipse + TextBlock」拼法
                                         （文字按文本框居中，字形重心必然偏），
                                         改用 Icons.xaml 里取自 Lucide 的 IconHelpCircle 矢量图标。
                                         最后用户说「和文字对的不齐，需要向下、向左来一点」。

                                         📐 **对齐是靠量像素定的，不是靠眼看**：
                                         截图后取两团墨迹的包围盒 ——
                                           标题「鸽子下载」墨迹 y 72..90，中心 81.0
                                           「?」图标墨迹    y 72..87，中心 79.5
                                         → 图标比文字**高 1.5px**；水平方向文字右缘 151、图标左缘 163
                                         → 间隙 11px（偏大）。据此把图标下移 1.5px、左移 5px。 -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="鸽子下载" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Button Click="OnAboutClick"
                                                Style="{StaticResource IconGhostButton}"
                                                Width="18" Height="18" Margin="3,0,0,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="关于"
                                                ToolTip="关于 鸽子下载 / 赞赏支持">
                                            <Path Data="{StaticResource IconHelpCircle}"
                                                  Stretch="Uniform" Width="13" Height="13"
                                                  Stroke="{DynamicResource TextTertiaryBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round">
                                                <!-- ⚠️ 用 RenderTransform 而不是 Margin 做这 1.5px 的垂直微调：
                                                     Margin 会**参与布局** —— 按钮 18 高，一旦加上下
                                                     margin 就会把这一行从 20 顶到 21，把下面的副标题
                                                     「多网盘下载器」整行推下去。
                                                     RenderTransform 只挪渲染，布局尺寸一点不变。 -->
                                                <Path.RenderTransform>
                                                    <TranslateTransform X="0" Y="1.5"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="多网盘下载器" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 导航（ListBox，与 Tabs 用 SelectedIndex 双向同步） -->
                        <!-- 🚨 必须关掉 WPF 自带的「首字母定位」（TextSearch）：
                             它是一个 ListBox 就会自带 —— 焦点在导航上时按 s 会跳到「设置」、
                             按 r 跳到「任务」……选中一变页面就切了，用户会以为"某个字母键是快捷键"。
                             这不是我们的快捷键，是框架行为，所以显式关掉。 -->
                        <ListBox x:Name="NavList" Grid.Row="1"
                                 Style="{StaticResource NavListBox}"
                                 ItemContainerStyle="{StaticResource NavListItem}"
                                 SelectionChanged="OnNavSelectionChanged"
                                 IsTextSearchEnabled="False"
                                 local:RippleEffect.IsEnabled="True"
                                 Margin="12,4,12,0"
                                 VerticalAlignment="Top">
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}"
                                          Style="{StaticResource NavItemIcon}"/>
                                    <TextBlock Text="下载" Style="{StaticResource NavItemText}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconActivity}"
                                          Style="{StaticResource NavItemIcon}"/>
                                    <TextBlock Text="任务" Style="{StaticResource NavItemText}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSettings}"
                                          Style="{StaticResource NavItemIcon}"/>
                                    <TextBlock Text="设置" Style="{StaticResource NavItemText}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconUser}"
                                          Style="{StaticResource NavItemIcon}"/>
                                    <TextBlock Text="登录" Style="{StaticResource NavItemText}"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <!-- ======== 账号卡（左下角）========
                             对应 code-behind 的 UpdateAccountCard()。

                             ⚠️ 关于"登录前后高度差太大"：
                             之前未登录态把整块 CapacityBox 设 Collapsed，卡片只有
                             头像+两行字；登录态多出容量条+用量文字共约 20px，
                             于是两个状态一高一矮，切换时整张卡会跳。
                             现在改成：**两种状态结构完全一致、高度恒定**，
                             未登录时容量条显示为 0 值的灰色空槽 + 一句占位文案。
                        -->
                        <!-- 提示区（用户要求「在账号卡片的上方用好看不突兀的方式
                                 加一句『按住 Shift 可多选文件』」，随后又要求
                                 「在这个的上方用同样的方式写出文件右键可选择免转存下载」，
                                 再后来要求「将上方的话放到下面因为它更长一些」，
                                 并纠正为「我要的是文件右键不是右键文件」）。

                                 → 现在是**两行**提示，都在账号卡上方（短句在上、长句在下）：
                                   第一行（原有）：按住 Shift → 可多选文件
                                   第二行（新增）：文件 → 右键 → 可免转存下载（夸克 / UC）
                                   ⚠️ 2026-11-01：必须限定「夸克 / UC」—— 阿里与迅雷在平台层面
                                      做不到免转存，写成通用会误导用户。
                                 两行共用同一套「键帽 + 说明」语言，字号 11、三级色，
                                 比账号卡的昵称弱一档 → 是"提示"而不是"告示"，不抢视线。 -->
                        <StackPanel Grid.Row="2" Margin="15,0,0,7">
                            <!-- 第一行：按住 Shift 可多选文件（原有，较短句放上面） -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="按住" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource BorderBrushStrong}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="5,0" Margin="4,0" MinWidth="34"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Shift" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <TextBlock Text="可多选文件" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>

                            <!-- 第二行：文件 右键 可选择免转存下载（较长句放下面；读作「文件 · 右键 · …」） -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="文件" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource BorderBrushStrong}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="5,0" Margin="4,0" MinWidth="34"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="右键" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <TextBlock Text="可免转存下载（夸克 / UC）" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 2026-11-01（用户反馈「左下角的登录框不是早已经删除了吗为什么又出现了」）：
                             侧栏账号卡 AccountCard 整块删除。
                             它在本轮之前的 XAML 恢复事故中被 git HEAD 版本带回来了。
                             账号/容量统一在「登录」页的「当前状态」卡里看（AGENTS.md 11.1）。 -->
                    </Grid>
                </Border>

                <!-- ============ 内容区 ============ -->
                <TabControl x:Name="Tabs" Grid.Column="1" Style="{StaticResource NavTabControl}">

                <!-- ============ 下载 ============ -->
                <TabItem Style="{StaticResource HeadlessTabItem}">
                    <!-- 页面外框留白统一到 8px 网格：
                         左右 24px（建议规范的「页面左右边距」档），上下 24px。
                         原来是 20,18,20,18 —— 18 不是网格值，且上下留白偏少，
                         底部按钮区贴边，观感"被硬塞在窗口底部"。 -->
                    <Grid Margin="24,24,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 页头：标题与副标题之间用 4px（紧凑），整块与下方内容之间 20px。
                             原来是 16px，改成 20px 让"标题区"与"操作区"分层更清楚。 -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="下载" Style="{StaticResource PageTitleText}"/>
                            <TextBlock Text="粘贴分享链接解析，或先登录后在「我的网盘」里选择文件"
                                       Style="{StaticResource TertiaryText}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- 模式切换：分段控件（2026-10-17 滑块指示器：
                             thumb 是整段面板共用的白底滑块，切选项时滑过去） -->
                        <Border Grid.Row="1" HorizontalAlignment="Left" CornerRadius="8"
                                Background="{DynamicResource SurfaceSunkenBrush}" Padding="3" Margin="0,0,0,12">
                            <Grid local:SegmentedSlider.IsEnabled="True"
                                  local:SegmentedSlider.Thumb="{x:Reference ModeThumb}">
                                <Border x:Name="ModeThumb" CornerRadius="6" HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch" IsHitTestVisible="False"
                                        Background="{DynamicResource SurfaceBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ShareModeRadio" Content="分享链接"
                                                 Checked="OnModeChanged" Style="{StaticResource SegmentedRadio}"
                                                 Margin="0"/>
                                    <RadioButton Content="我的网盘"
                                                 Checked="OnModeChanged" Style="{StaticResource SegmentedRadio}"
                                                 Margin="2,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 分享面板（卡片）
                             用户反馈「这里做的 ui 总感觉很僵硬，特别是那个解析按钮」。
                             实测出三处不协调：
                               ① 输入框高 34px（padding 7 + 边框 1 + 文字 18），
                                  而主按钮高 32px（padding 7 + 文字 18，无边框）
                                  → 按钮比输入框**矮 2px**，并排时明显不齐；
                               ② 提取码框只有 96px 宽，夹在长输入框和按钮之间显得局促；
                               ③ 提取码标签与按钮前的间距不一致（12/10 混用），节奏乱。
                             现在统一成：三个控件**同高 34px**、提取码框加宽到 120px、
                             间距统一 14px，按钮 padding 放宽到 20 让它不像个"方块"。 -->
                        <!-- SharePanel 加**聚焦态**：
                             LinkBox 获得焦点时，整张卡片边框变主色 + 一层极淡发光
                             （Raycast 的大搜索框体验：聚焦时"整个条"有反应，而不是只输入框自己变）。
                             用 IsKeyboardFocusWithin 触发，这样点扫码/清空按钮时焦点仍在条内，
                             ���不会闪烁。发光用 DropShadowEffect（这里是 Border 不是 Popup，
                             不存在 ContextMenu 那种被窗口裁切的问题）。 -->
                        <!-- ⚠️ Style 只能设一次：这里用 <Border.Style>（BasedOn Card），
                             不再在标签上写 Style="{StaticResource Card}"，否则 MC3024。 -->
                        <Border x:Name="SharePanel" Grid.Row="2" Margin="0,0,0,14">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <!-- 聚焦反馈从"边框变蓝 + 蓝色发光"改成
                                                 "边框加深"—— 克制、不引入彩色。发光也去掉（那是模板化观感的来源）。 -->
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                          <Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- 扫码按钮移到「输入框」与「提取码」之间 -->
                                    <ColumnDefinition Width="*"/>      <!-- 输入框 -->
                                    <ColumnDefinition Width="Auto"/>   <!-- 扫码按钮 -->
                                    <ColumnDefinition Width="Auto"/>   <!-- 提取码 输入框 -->
                                    <ColumnDefinition Width="Auto"/>   <!-- 解析 按钮 -->
                                </Grid.ColumnDefinitions>
                                <!-- 原「分享链接」文字标签删除，改用 placeholder。
                                     原因：Auto 列总宽超出可用宽度 → Grid 不压缩 Auto 列 → 右侧「解析」按钮
                                     被挤出窗口（UIA 实测解析按钮右边缘 1345 > 窗口 1240，溢出 105px）。
                                     去掉两个文字标签省下约 160px，且 placeholder 是现代表单的标准做法
                                     （Raycast / Notion 都这么干）。 -->
                                <!-- ⚠️ 高度必须是 42，不能是 34 —— 这是实测出来的下限。
                                     AppTextBox 的模板把 Padding(10,7) 当作 ScrollViewer 的 Margin，
                                     再加上 1px 边框，内容区需要约 26px 才放得下一行字。
                                     34 时内容区只剩 18px → **文字和光标被裁成一条细缝**
                                     （用户反馈「光标怎么这么小了我输入文字也看不见了」）。
                                     离屏渲染逐档实测：34/36/38/40 都裁，**42 起完整显示**。
                                     真正的病根已找到并修掉：模板把
                                     Padding 用了两遍（WPF 的 TextBoxView 自己也会按 Padding
                                     缩进），天然高度因此虚高到 46.5。修完天然高度 32.5，
                                     34 也不再裁字。这里仍保留 42，是为了和提取码框、解析
                                     按钮同高（视觉上一排整齐），不是为了躲裁切。 -->
                                <!-- 扫码按钮**移到输入框外**（独立一列，在输入框左侧）。
                                     用户原话：「扫描二维码的图标拿出到输入框外」。
                                     原来是绝对定位贴在输入框内部右缘，与清空按钮挤在一起、
                                     还逼得输入框右内边距要留 58px —— 现在独立成列，输入框干净了。 -->
                                <!-- 用户要求「图标在输入框与提取码之间居中」。
                                     🔎 真正的病根：**提取码那一列自带 `Margin="14,0,0,0"`**（见下方 Grid.Column=2），
                                        而扫码按钮原来是 `7,0,7,0` ⇒ 两侧间距根本不相等：
                                          左 = 7 + (36-16)/2 = 17px
                                          右 = (36-16)/2 + 7 + **14** = 31px   ← 多出 14
                                        ⇒ 图标整体偏左。
                                     ✅ 修法：把左边补成 14、右边归零 ⇒ 左 = 14+10 = 24，右 = 10+0+14 = 24，**严格居中**。
                                     ✅ 总占宽仍是 50（36+14+0 = 36+7+7），输入框宽度一点不受影响。

                                     用户要求**删掉扫码按钮的悬停提示**（原来那串
                                     「识别二维码：把夸克分享二维码图片识别成链接（也可直接 Ctrl+V 粘贴截图）」
                                     太长、挡视线）⇒ 直接不设 ToolTip，悬停不再弹任何文字。
                                     ⚠️ 别再加回来；`AutomationProperties.Name` 保留（UIA 定位 + 无障碍要用）。 -->
                                <Button x:Name="ScanQrBtn" Click="OnScanQrClick"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,0" Width="36" Height="36"
                                        Cursor="Hand" Focusable="False"
                                        AutomationProperties.Name="识别二维码">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent"
                                                                CornerRadius="6">
                                                            <Path Data="{StaticResource IconScan}"
                                                                  Stretch="Uniform" Width="16" Height="16"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Stroke="{DynamicResource TextTertiaryBrush}"
                                                                  StrokeThickness="1.8"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background"
                                                                        Value="{DynamicResource SurfaceAltBrush}"/>
                                                                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <!-- 常年可见：这是功能入口，不能像清空按钮那样空着就藏起来 -->
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Grid Grid.Column="0">
                                    <!--
                                         目标：把「输入框 + 扫码/清空/解析」合成**一个整体**，
                                         而不是三个各自带边框的控件排一排（那是"控件堆叠"感）。
                                         做法（Raycast 的做法）：**输入框本身无边框，边框只在容器上**。
                                         ⚠️ 这里用局部 Style 覆盖 AppTextBox 的边框三件套，
                                         不改全局 AppTextBox（PassBox 等还要用它原来的样子）。
                                         ⚠️ 高度仍保持 42：那是实测出来的下限（34/36/38/40 都会裁字），
                                         且与提取码框、解析按钮同高，视觉上一排整齐。
                                         ⚠️ Padding 右内边距仍 58：给 ScanQrBtn + LinkClearBtn 留位（红线）。 -->
                                    <TextBox x:Name="LinkBox" Height="42"
                                             Padding="12,7,30,7"
                                             AutomationProperties.Name="分享链接输入框"
                                             DataObject.Pasting="OnLinkBoxPasting"
                                             >
                                        <TextBox.Style>
                                            <!-- 上一版按 Raycast 做成"输入框完全无边框无底色"，
                                                 结果在白卡片上**彻底看不见** —— 用户反馈「解析框不见了」，
                                                 根本不知道那里能输入。可用性 > 风格。
                                                 ✅ 折中：保留"无硬边框"（不画 1px 灰线，那是模板化观感的来源），
                                                 改用**极淡的凹陷底色**（SurfaceSunken）表达"这里可以输入"。
                                                 配合外层 SharePanel 聚焦时边框变主色 + 淡光。 -->
                                            <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <!-- placeholder：替代被删的「分享链接」文字标签（省 Auto 列宽度，修溢出） -->
                                    <TextBlock Text="粘贴分享链接…"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               IsHitTestVisible="False" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=LinkBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 一键清空：贴在输入框右侧内缘。
                                         只在有内容时出现（空的时候显示一个点了没反应的叉很别扭）。 -->
                                    <Button x:Name="LinkClearBtn" Click="OnClearLinkBox"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,6,0" Width="22" Height="22"
                                            Cursor="Hand" Focusable="False"
                                            ToolTip="清空">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent"
                                                                    CornerRadius="6">
                                                                <Path Data="{StaticResource IconClose}"
                                                                      Stretch="Uniform" Width="9" Height="9"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Stroke="{DynamicResource TextTertiaryBrush}"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background"
                                                                            Value="{DynamicResource SurfaceAltBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <!-- 输入框为空 → 收起（避免点了没反应的死按钮） -->
                                                    <DataTrigger Binding="{Binding Text, ElementName=LinkBox}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <!-- 提取码：包一层 Grid 以便叠加 placeholder（原「提取码」标签已删） -->
                                <Grid Grid.Column="2" Margin="14,0,0,0">
                                    <TextBox x:Name="PassBox" Width="130" Height="42"
                                             AutomationProperties.Name="提取码输入框"
                                             Style="{StaticResource AppTextBox}"/>
                                    <TextBlock Text="提取码"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               IsHitTestVisible="False" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PassBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <!-- 解析按钮上的 2 颗装饰星已删除（用户：「加的几颗星星反而让它更丑了」）。
                                     现在就是一个干净的实心块。 -->
                                <Button x:Name="ParseBtn" Grid.Column="3" Content="解析"
                                        Click="OnParseClick"
                                        Height="42" Padding="24,0" VerticalAlignment="Center"
                                        Margin="14,0,0,0"
                                        Style="{StaticResource PrimaryButton}"/>
                            </Grid>
                          </Grid>
                        </Border>

                        <!-- 四家网盘切换条（2026-11-01 重建）：
                             按钮由 C# 的 RefreshDrivePanTabs() 生成，这里只放容器。
                             整条共用一个 DrivePanThumb 滑块，位置由 PlaceDrivePanThumb() 按
                             选中按钮的 X/宽度算，切换时走 DoubleAnimation 滑过去。 -->
                        <Border x:Name="DrivePanTabsHost" Grid.Row="2" Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <Grid x:Name="DrivePanTabsRoot" HorizontalAlignment="Left">
                                <Border x:Name="DrivePanThumb"
                                        Height="2" CornerRadius="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        IsHitTestVisible="False"
                                        Background="{DynamicResource TextPrimaryBrush}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="DrivePanThumbShift" X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                                <StackPanel x:Name="DrivePanTabs" Orientation="Horizontal"/>
                            </Grid>
                        </Border>

                        <!-- 目录导航（分享/网盘通用） -->
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!--
                                    ⚠️ 这里必须是 *，不能是 Auto。
                                    Auto 会让文件列表区"有多高算多高"，列表为空时
                                    只剩空状态那一小条，下面留一大片死白（用户截图反馈）。
                                    * 让它吃掉剩余空间，空状态也能在正中间居中。
                                -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 目录路径条（面包屑）。
                                     外层换成 Grid 而不是 StackPanel：水平 StackPanel 会用
                                     **无限宽**去量孩子，长路径就会溢出到右边的搜索框上，
                                     而且溢出的部分照样能点到 —— 会挡住搜索框。
                                     Grid 的 * 列能把宽度约束住，再由 ScrollViewer 在超出时
                                     横向滚动（滚动条隐藏），UpdatePathText 每次都会滚到右端，
                                     保证"当前在哪一层"始终看得见。 -->
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconFolder}"
                                          Stretch="Uniform" Width="15"
                                          Height="15" Stroke="{DynamicResource TextTertiaryBrush}"
                                          StrokeThickness="1.8" VerticalAlignment="Center"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                    <!-- 每一节由 UpdatePathText() 动态生成 ——
                                         祖先层是 BreadcrumbButton（悬停高亮、点击直达），
                                         当前层是普通文字（不可点）。 -->
                                    <ScrollViewer x:Name="DrivePathScroll" Grid.Column="1"
                                                  Margin="8,0,0,0" Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="DrivePathBar" Orientation="Horizontal"
                                                    VerticalAlignment="Center"/>
                                    </ScrollViewer>
                                </Grid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <!-- 搜索框：从"白底描边胶囊"改为"凹陷底色无边框"。
                                         与来源栏（LinkBox）同一套语言，工具栏区视觉统一。
                                         外层 Border 只负责圆角和凹陷底色，不画边框。 -->
                                    <Border CornerRadius="8"
                                            Background="{DynamicResource SurfaceSunkenBrush}"
                                            Height="32" Width="190" Margin="0,0,8,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                                  Stretch="Uniform" Width="13" Height="13" Margin="9,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource TextTertiaryBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <TextBox x:Name="FileFilterBox" Grid.Column="1"
                                                     TextChanged="OnFileFilterChanged" BorderThickness="0"
                                                     Background="Transparent" Padding="6,0,7,0"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="12"
                                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                     ToolTip="按名称筛选当前目录的文件/文件夹"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="DriveUpBtn" Click="OnUp" Style="{StaticResource ToolButton}"
                                            ToolTip="返回上级目录">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconArrowUp}" Stretch="Uniform"
                                                  Width="13" Height="13" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                            <TextBlock Text="上级" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DriveRefreshBtn" Click="OnRefresh"
                                            Style="{StaticResource ToolButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- ⚠️ IconRefresh 是实心几何，只能上 Fill（见 Icons.xaml 注释）。 -->
                                            <Path Data="{StaticResource IconRefresh}" Stretch="Uniform"
                                                  Width="13" Height="13" VerticalAlignment="Center"
                                                  Fill="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="刷新" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- 解析历史的**看得见**的入口：用户要求
                                         「在我的网盘右侧也加一个，更直观」——
                                         单靠 h 键没人猜得到。⚠️ 这条工具栏是两个模式共用的，
                                         所以「分享链接」模式下也一并显示（两边都能用，不冲突）。
                                         按用户要求**删掉悬停提示**
                                         （原来那串「解析历史：最近解析过的分享，点一条即可重新打开」）。
                                         别再加回来；按钮自身带「解析历史」文字，信息已足够。 -->
                                    <Button Click="OnShareHistoryButtonClick"
                                            Style="{StaticResource ToolButton}" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconHistory}" Stretch="Uniform"
                                                  Width="13" Height="13" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                            <TextBlock Text="解析历史" Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 文件列表 -->
                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- 列表占满；底部那行只在"还有没加载完的"时候才有高度 -->
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- ⚠️ SelectionMode=Extended 本来 Shift+点击 = **连选**（整段区间）。
                                         用户要求「可以使用 shift 多选，但不是连选」——
                                         即 Shift+点击只切换**这一个**项的选中态。
                                         做法见 OnListPreviewMouseDown（拦下 Shift 点击自己处理）。
                                         单击 = 选中，**双击文件夹才进目录**
                                         （OnFileListDoubleClick）。第三方分支 v2.4 曾改成
                                         「单击直接进入」并摘掉本事件，**我们不采纳**那个改动。 -->
                                    <ListBox x:Name="FileList" SelectionMode="Extended"
                                             Style="{StaticResource PlainListBox}"
                                             ItemContainerStyle="{StaticResource FileListItem}"
                                             IsTextSearchEnabled="False"
                                             PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                             MouseDoubleClick="OnFileListDoubleClick"
                                             MouseRightButtonUp="OnFileListRightClick">
                                <ListBox.ContextMenu>
                                    <!-- 🚨 2026-11-01（用户报「支持免转存的两个网盘右键文件
                                         不能出现免转存选项了」）：原来菜单项的 Visibility 是在
                                         ListBox 的 MouseRightButtonUp 里设的 —— 而 WPF 的
                                         ContextMenu 在**鼠标按下/抬起过程中**就已经弹出并完成布局，
                                         等到 Up 事件里再改 Visibility，菜单早已渲染完毕，改了也看不见。
                                         ⇒ 改挂 ContextMenu.Opened（与任务列表的
                                            OnTaskContextMenuOpened 同一做法），在菜单**即将显示**
                                            时同步可见性，一定生效。 -->
                                    <ContextMenu Opened="OnFileContextMenuOpened">
                                        <!-- 🚨 2026-11-01（用户报「点击右键免转存下载这个功能直接被你删了」）：
                                             上一轮 XAML 重建时，这一项只补了 x:Name 与图标，
                                             **漏掉了 Click 绑定** —— 菜单能显示，但点了毫无反应。
                                             处理方法一直存在（MainWindow.Download.cs 的
                                             OnDownloadSelectedNoSave），补上绑定即可。 -->
                                        <MenuItem x:Name="NoSaveDownloadMenuItem" Header="免转存下载"
                                                  Click="OnDownloadSelectedNoSave">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource IconDownload}" Stretch="Uniform"
                                                      Width="14" Height="14"
                                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 目录/文件图标 -->
                                                    <Path Grid.Column="0" Stretch="Uniform" Width="16" Height="16"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Data"
                                                                        Value="{StaticResource IconFile}"/>
                                                                <Setter Property="Stroke"
                                                                        Value="{DynamicResource TextTertiaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDir}" Value="True">
                                                                        <Setter Property="Data"
                                                                                Value="{StaticResource IconFolder}"/>
                                                                        <Setter Property="Stroke"
                                                                                Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" Margin="0,0,16,0"
                                                               Style="{StaticResource BodyText}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource TertiaryText}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- ===== 非内容状态：三态互斥（加载中 / 空 / 有内容） =====
                                         之前只有"空"一种，加载目录的几百毫秒里空状态会跳出来
                                         喊"还没有内容"，误导用户。现在拆开，由
                                         code-behind 的 UpdateFileStates() 统一裁决可见性。 -->

                                    <!-- 加载中
                                         去掉**旋转动画**（规范里"不要做"的一项：
                                         旋转加载圈是最典型的模板化元素）。保留图标 + 文案，
                                         改为静态显示 —— 加载态靠文字说明，不靠动效抢注意力。
                                         ⚠️ 这不影响 UiBusy.cs 的按钮「加载中」态（那是另一套，MinBusyMs=280），
                                         也不影响 LoadingSpinner 样式本身（仍在 Styles.xaml，可复用）。 -->
                                    <StackPanel x:Name="FileLoadingState" IsHitTestVisible="False"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <Path Data="{StaticResource IconSpinner}"
                                              Style="{StaticResource LoadingSpinner}"
                                              HorizontalAlignment="Center"/>
                                        <TextBlock Text="正在加载…" Margin="0,10,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TertiaryText}"/>
                                    </StackPanel>

                                    <!-- 空 -->
                                    <StackPanel x:Name="FileEmptyState" IsHitTestVisible="False"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <!-- 空状态改 Notion 式三级层级：
                                             ① 图标 40 → 64px，颜色从 BorderBrushStrong（描边色，极淡、几乎看不见）
                                                改成 PrimarySoftBrush（主色浅版）—— 空状态是全页最该被"看见"的引导，
                                                不该是最淡的元素；
                                             ② 标题「还没有内容」从 TertiaryText 提到 14px SemiBold + TextPrimaryBrush；
                                             ③ 引导文案保持 12px TertiaryText。
                                             改前两级都是三级灰字，主次不分、整体发虚。 -->
                                        <Path Data="{StaticResource IconCloudOff}" Stretch="Uniform" Width="64"
                                              Height="64" HorizontalAlignment="Center" Margin="0,0,0,16"
                                              Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                        <TextBlock x:Name="FileEmptyText" Text="还没有内容"
                                                   Margin="0,0,0,6" HorizontalAlignment="Center"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="粘贴分享链接解析，或切到「我的网盘」选择文件"
                                                   Margin="0,0,0,0" HorizontalAlignment="Center"
                                                   Style="{StaticResource TertiaryText}" FontSize="12"/>
                                    </StackPanel>

                                    <!-- 分页提示：目录大时列表一次只"露"一批条目，
                                         这行告诉用户"下面还有"，滚到底会自动续上（见 LoadMoreItems）。 -->
                                    <TextBlock x:Name="FileMoreHint" Grid.Row="1"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Center" Margin="0,2,0,10"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 操作按钮
                             上方留白 12 → 24，与内容区拉开呼吸。
                             这是"AI味"诊断里指出的「按钮区像被硬塞在窗口底部」的正解：
                             **用空间分隔，不画分割线**（Linear 的做法 —— 线是噪音，留白才是层级）。 -->
                        <!-- 三个按钮靠右对齐 —— 原来贴左边，右侧一大片空白，
                             视觉重心全压在左半边。 -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,24,0,0">
                            <!-- Fluent 主次原则：**一个视图只有一个实心主操作**。
                                 改前「下载选中」实心、「下载全部」描边 —— 其实已经是主次分明的。
                                 这里做的是**统一三者的视觉重量**：下载全部从 SecondaryButton 降为
                                 GhostButton（更轻），让「下载选中」成为唯一焦点；
                                 获取直链本来就是次要操作，保持 GhostButton。
                                 ⚠️ 若想改回"两个实心"，把 DownloadAllBtn 的 Style 换回 SecondaryButton 即可。 -->
                            <Button x:Name="DownloadSelBtn" Click="OnDownloadSelected"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 图标颜色必须跟按钮前景色走 → SolidBtnFgBrush。
                                         别写 TextOnPrimaryBrush：那个两个主题都是纯白，而暗色主题的实心按钮
                                         是「浅灰底 #E8EAF0」，白图标画上去就消失了（用户反馈看不见）。 -->
                                    <Path Data="{StaticResource IconDownload}" Stretch="Uniform" Width="14"
                                          Height="14" VerticalAlignment="Center"
                                          Stroke="{DynamicResource SolidBtnFgBrush}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                    <TextBlock Text="下载选中" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- 三个按钮之间的**视觉缝隙不一致**。
                                 根因：GhostButton 的 Padding 是 10,5、FontSize 12（比 Primary 的 16,7 / 13 小），
                                 按钮实际边界更窄 → 看起来中间那道缝更大。
                                 这里给「下载全部」本地覆盖成与另外两个完全一致的 16,7 / 13。 -->
                            <!-- 幽灵按钮背景透明、看不见边界，
                                 视觉上「实心→幽灵」的缝隙会比「幽灵→描边」小（光学错觉），
                                 代码里明明都是 8px 却看着不匀。改成 SecondaryButton
                                 （白底 + 1px 描边，Padding 15,7 已做边框补偿），三个按钮边界都清晰。 -->
                            <Button x:Name="DownloadAllBtn" Click="OnDownloadAll"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Stretch="Uniform" Width="14"
                                          Height="14" VerticalAlignment="Center"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                    <TextBlock Text="下载全部" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="FetchLinksBtn" Click="OnFetchLinks"
                                    Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconLink}" Stretch="Uniform" Width="14"
                                          Height="14" VerticalAlignment="Center"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                    <TextBlock Text="获取直链" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- 按钮右边那串「获取直链后可导出为 …」删掉。
                                 这句已经移到「获取直链」对话框标题下方，主界面不再重复。 -->
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ============ 任务 ============ -->
                <TabItem Style="{StaticResource HeadlessTabItem}">
                    <!-- 页面外框留白统一到 8px 网格：
                         左右 24px（建议规范的「页面左右边距」档），上下 24px。
                         原来是 20,18,20,18 —— 18 不是网格值，且上下留白偏少，
                         底部按钮区贴边，观感"被硬塞在窗口底部"。 -->
                    <Grid Margin="24,24,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- Row0 标题 -->
                            <RowDefinition Height="Auto"/>   <!-- Row1 筛选+工具栏 -->
                            <!-- 🚨🚨 Row2 任务列表**必须是星号**，绝不能是 Auto。
                                 2026-11-01 我曾把它误改成 Auto，后果：Auto 行高=内容高度，
                                 任务列表为空时高度=0，下面的日志区直接顶到工具栏下方 ——
                                 表现为「日志框跑到最上面、任务列表整个消失」。
                                 星号让任务列表吃掉剩余空间，空态也能正常居中。
                                 ⚠️ 危险的是「Auto 行里套星号子行」，不是「行本身写星号」。 -->
                            <RowDefinition Height="*"/>      <!-- Row2 任务列表 -->
                            <RowDefinition Height="Auto"/>   <!-- Row3 日志区 -->
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="任务" Style="{StaticResource PageTitleText}"/>
                            <!-- 副标题一行：左边是操作说明（原有），右边小字补一句
                                 「文件需下载部分才可播放」（用户要求「在这个的右边，
                                 用美观的方式增加一行小字」）。
                                 用一条同色系极淡的竖分隔符「·」隔开，字号 11 比说明再弱一档，
                                 做到"补充说明"而不是并列信息。 -->
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="右键任务行可单独暂停 / 恢复 / 取消 / 删除并移除"
                                           Style="{StaticResource TertiaryText}"/>
                                <TextBlock Text="·" Margin="7,0"
                                           FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Opacity="0.6"/>
                                <TextBlock Text="文件需下载部分才可播放"
                                           FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Opacity="0.85"/>
                            </StackPanel>
                            <!-- 任务分类 Tab（参考 Motrix 的任务列表分类）。
                                 原来所有任务混在一个列表里，"哪个失败了"得自己一行行扫。
                                 4 个分类**共用同一个 TaskList**，只切换 ICollectionView 的过滤器
                                 （用 TabItem 会需要 4 份列表副本 → 状态不同步）。 -->
                            <!-- 2026-10-17：滑块下划线指示器（FilterTabRadio 样式不再自绘下划线，
                                 指示条长这样 Height=2 的滑块在四个筛选项间滑动） -->
                            <Grid Margin="0,16,0,0"
                                  local:SegmentedSlider.IsEnabled="True"
                                  local:SegmentedSlider.Thumb="{x:Reference FilterThumb}">
                                <Border x:Name="FilterThumb" Height="2" VerticalAlignment="Bottom"
                                        HorizontalAlignment="Left" IsHitTestVisible="False"
                                        Background="{DynamicResource TextPrimaryBrush}"/>
                                <!-- 计数从「紧跟已完成」移到整行最右，
                                     与分类 Tab 同一水平线（左列自适应、右列 Auto）。 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <RadioButton x:Name="TaskFilterAll" Content="全部"
                                                     GroupName="TaskFilter" IsChecked="True"
                                                     Style="{StaticResource FilterTabRadio}"
                                                     Checked="OnTaskFilterChanged"
                                                     AutomationProperties.Name="全部任务"/>
                                        <RadioButton x:Name="TaskFilterActive" Content="进行中"
                                                     GroupName="TaskFilter"
                                                     Style="{StaticResource FilterTabRadio}"
                                                     Checked="OnTaskFilterChanged"
                                                     AutomationProperties.Name="进行中的任务"/>
                                        <RadioButton x:Name="TaskFilterFailed" Content="失败"
                                                     GroupName="TaskFilter"
                                                     Style="{StaticResource FilterTabRadio}"
                                                     Checked="OnTaskFilterChanged"
                                                     AutomationProperties.Name="失败的任务"/>
                                        <RadioButton Content="已完成"
                                                     GroupName="TaskFilter"
                                                     Style="{StaticResource FilterTabRadio}"
                                                     Checked="OnTaskFilterChanged"
                                                     AutomationProperties.Name="已完成的任务"/>
                                    </StackPanel>
                                    <!-- 计数：让用户一眼看到每类有几条（不用切过去看） -->
                                    <TextBlock x:Name="TaskFilterCountText" Grid.Column="1"
                                               FontSize="11" VerticalAlignment="Center"
                                               Margin="0,0,2,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <!-- 「暂停全部 / 恢复全部」合并成一个按钮：
                                 图标与文案按当前任务状态自动切换（有在跑的就显示"暂停全部"，
                                 否则显示"恢复全部"），由 UpdatePauseAllButton() 在代码里维护。
                                 「取消全部」按钮按用户要求移除 —— 单个任务的「取消」仍在右键菜单里。 -->
                            <Button x:Name="PauseAllBtn" Click="OnPauseAllOrResume"
                                    Style="{StaticResource ToolButton}"/>
                            <Button Content="清空已完成" Click="OnClearDone"
                                    Style="{StaticResource ToolButton}"/>
                            <Button x:Name="HistoryBtn" Click="OnOpenHistory" Style="{StaticResource ToolButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconHistory}" Stretch="Uniform" Width="12"
                                          Height="12" VerticalAlignment="Center"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="下载历史" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenDiagnostics" Style="{StaticResource ToolButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDiagnostics}" Stretch="Uniform" Width="12"
                                          Height="12" VerticalAlignment="Center"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="诊断面板" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- 用户要求任务页也能直接打开下载目录（原来只有设置页有） -->
                            <Button Click="OnOpenOutDir" Style="{StaticResource ToolButton}"
                                    Margin="0" ToolTip="在资源管理器中打开下载目录">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Stretch="Uniform" Width="12"
                                          Height="12" VerticalAlignment="Center"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                    <TextBlock Text="打开下载目录" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 2026-11-01：这里原本被我加了 MinHeight="0"，已撤掉。
                             MinHeight=0 会让任务列表被压成 0 高度（空态时尤其明显），
                             表现为「任务列表消失、日志框跑到最上面」。
                             行定义用 * 就够，不需要额外压缩。 -->
                        <Grid Grid.Row="2">
                            <!-- 任务列表原来是默认的 SelectionMode=Single（根本多选不了），
                                 改成 Extended + 同一套 Shift 处理，和文件列表行为一致。 -->
                            <ListBox x:Name="TaskList" SelectionMode="Extended"
                                     Style="{StaticResource PlainListBox}"
                                     ItemContainerStyle="{StaticResource TaskListItem}"
                                     IsTextSearchEnabled="False"
                                     PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                                     MouseRightButtonUp="OnTaskListRightClick"
                                     >
                                <ListBox.ContextMenu>
                                    <!-- 2026-11-01 重建：按 MainWindow.Tasks.cs 的
                                         OnTaskContextMenuOpened 实际引用的控件名重建。
                                         「暂停/恢复」合并成一项，文案随状态切换；
                                         删除「仅移除记录」；「在资源管理器中定位」改名「定位文件」。 -->
                                    <ContextMenu x:Name="TaskContextMenu"
                                                 Opened="OnTaskContextMenuOpened">
                                        <MenuItem x:Name="TaskPauseResumeItem" Header="暂停" Click="OnTaskPauseResume">
                                            <MenuItem.Icon>
                                                <Path x:Name="TaskPauseResumeIcon"
                                                      Data="{StaticResource IconPause}" Stretch="Uniform"
                                                      Width="14" Height="14"
                                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="TaskCancelItem" Header="取消" Click="OnTaskCancel"
                                                  Foreground="{DynamicResource DangerBrush}">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource IconClose}" Stretch="Uniform"
                                                      Width="14" Height="14"
                                                      Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="删除并移除" Click="OnTaskDeleteLocal"
                                                  Foreground="{DynamicResource DangerBrush}">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource IconTrash}" Stretch="Uniform"
                                                      Width="14" Height="14"
                                                      Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator x:Name="TaskMenuSep1" Style="{StaticResource MenuSeparator}"/>
                                        <MenuItem x:Name="TaskPlayItem" Header="播放文件" Click="OnOpenTaskFile">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource IconFile}" Stretch="Uniform"
                                                      Width="14" Height="14"
                                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="定位文件" Click="OnLocateTaskFile">
                                            <MenuItem.Icon>
                                                <Path Data="{StaticResource IconFolder}" Stretch="Uniform"
                                                      Width="14" Height="14"
                                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                             Margin="0,0,9,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill"
                                                                        Value="{DynamicResource TextTertiaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding State}"
                                                                                 Value="Downloading">
                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource TextPrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}"
                                                                                 Value="Completed">
                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}"
                                                                                 Value="Failed">
                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}"
                                                                                 Value="Paused">
                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontWeight="SemiBold"
                                                               Style="{StaticResource BodyText}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding DetailText}"
                                                           Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="380"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource SecondaryText}"/>
                                                <!-- 行内「播放/暂停」切换按钮（纯图标，图标随状态互换）。
                                                     控制的是**这个下载任务**的暂停/恢复，
                                                     不是控制外部播放器（那做不到）。 -->
                                                <Button Grid.Column="2" Click="OnTaskTogglePause"
                                                        Tag="{Binding}" Style="{StaticResource TaskPauseButton}"
                                                        Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                <!-- 「播放」= 交给系统默认程序打开（装了 VLC 就用 VLC）。
                                                     按用户要求：只有**能播**的时候才显示这个按钮
                                                     （见 TaskItem.CanPlay）——
                                                       · 独立分片+边合并 → 目标文件从 0 连续增长，未下完也能边下边播 ✓
                                                       · 共写同一文件 → 预分配的满尺寸空洞文件，播放器打不开 ✗
                                                       · 已完成 → 文件完整，两种模式都能播 ✓
                                                     不能播时整个按钮收起（Collapsed），不留一个点了没用的入口。 -->
                                                <Button Grid.Column="3" Content="播放" Click="OnOpenTaskFile"
                                                        Tag="{Binding}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                        >
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanPlay}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Grid.Column="4" Content="定位" Click="OnLocateTaskFile"
                                                        Tag="{Binding}" Style="{StaticResource GhostButton}"
                                                        Margin="2,0,0,0" VerticalAlignment="Center"
                                                        />
                                            </Grid>
                                            <!-- 任务行第二排 = 连接车道 + 进度条 + 速度/已完成/百分比。
                                                 「连接车道」参考 Ketch 的招牌设计（每条连接一条活的车道）：
                                                 左侧 20 个小格子按"活跃连接占比"点亮，后面跟 12/16 连接 的文字。
                                                 作用：一眼判断"是服务端限速、还是客户端没把连接发出去"。
                                                 数据由 OnDiagnostics 从 DiagnosticsSnapshot 喂入（未改下载器内核）。 -->
                                            <Grid Grid.Row="1" Margin="16,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>   <!-- 车道格子 -->
                                                    <ColumnDefinition Width="Auto"/>   <!-- 连接数文字 -->
                                                    <ColumnDefinition Width="*"/>      <!-- 进度条 -->
                                                    <ColumnDefinition Width="Auto"/>   <!-- 速度 -->
                                                    <ColumnDefinition Width="Auto"/>   <!-- 已完成 -->
                                                    <ColumnDefinition Width="Auto"/>   <!-- 百分比 -->
                                                </Grid.ColumnDefinitions>
                                                <ItemsControl Grid.Column="0" ItemsSource="{Binding Lanes}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="3" Height="10" Margin="0,0,2,0"
                                                                    CornerRadius="1.5">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource BorderBrushSoft}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding}" Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="{DynamicResource TextSecondaryBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Grid.Column="1" Text="{Binding LaneText}"
                                                           Margin="0,0,12,0" VerticalAlignment="Center"
                                                           MinWidth="66" FontSize="11"
                                                           Style="{StaticResource TertiaryText}"/>
                                                <ProgressBar Grid.Column="2"
                                                             Style="{StaticResource SlimProgressBar}"
                                                             Value="{Binding Percent}"
                                                             VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SpeedText}"
                                                           Margin="12,0,0,0" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" MinWidth="72"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Style="{StaticResource NumericText}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding DoneText}"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource TertiaryText}"/>
                                                <TextBlock Grid.Column="5" Text="{Binding PercentText}"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                                           MinWidth="48" TextAlignment="Right"
                                                           Style="{StaticResource NumericText}"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="TaskEmptyState" IsHitTestVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Visible">
                                <!-- 与下载页空状态保持同一套 Notion 式三级层级：
                                     图标 64px + PrimarySoftBrush、标题 14px SemiBold TextPrimary、
                                     引导 12px TertiaryText。两个空状态必须一致，否则一精一糙。 -->
                                <Path Data="{StaticResource IconActivity}" Stretch="Uniform" Width="64"
                                      Height="64" HorizontalAlignment="Center" Margin="0,0,0,16"
                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                                <TextBlock Text="暂无下载任务" Margin="0,0,0,6" HorizontalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="在「下载」页解析链接并选择文件后，任务会出现在这里"
                                           Margin="0,0,0,0" HorizontalAlignment="Center"
                                           Style="{StaticResource TertiaryText}" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- 运行日志（从「下载」页迁来：日志讲的是任务跑得怎么样，放任务页更贴）
                             高度固定 132px，不出内容时也占位，避免切换任务多寡时整页跳动。 -->
                        <!-- 🚨 2026-11-01：这里**不要**写 MinHeight / Height="*"。
                             Auto 行里再套 * 行 + MinHeight，会让 WPF 的测量阶段
                             在「Auto 给无限高」与「* 需要确定高」之间来回震荡 ——
                             表现为整个程序 CPU 飙高、窗口无响应（实测卡死）。
                             恢复成原来已验证的写法：标题行 Auto + 日志框固定 132。 -->
                        <!-- 日志框高度 132 → 104（2026-11-01）。
                             默认窗口 780 高时，任务页「标题+筛选+工具栏+列表」已占满，
                             132 的日志框会把整块日志区（含分段控件）顶到窗口外，
                             只露出标题行。104 能完整放下，且仍够看 5~6 行日志。
                             ⚠️ 不要改成 MinHeight / Height="*" —— 见下方注释，那会引发测量死循环。 -->
                        <!-- 🚨 ClipToBounds：日志框是 TextWrapping=NoWrap，
                             长行会让 TextBox 想变得更宽，把整个日志区 Grid 撑开 ——
                             标题行右侧的「简要/详细」「导出诊断包」就会被顶到窗口外。
                             ClipToBounds 让超宽部分直接裁掉，不再影响布局测量。 -->
                        <!-- 🚨🚨 绝不要在这里写 MaxWidth 绑定到父级 ActualWidth：
                             那会在测量阶段形成「父测子→子问父」的循环，
                             实测直接把程序卡死（窗口无响应、CPU 飙高）。
                             保持最朴素的写法，宽度交给 WPF 布局系统。 -->
                        <Grid Grid.Row="3" Margin="0,14,0,0" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- 日志框高度 132（2026-11-01 用户拍板方案 C）。
                                     曾临时降到 104 让整页放得下，但日志只能显示 5 行、偏少；
                                     调回 132 恢复 6~7 行。
                                     ⚠️ 这是纯数值调整，**不会**引发测量死循环；
                                     真正危险的是把 Auto 行改成 * 行、或绑 ActualWidth。 -->
                                <RowDefinition Height="132"/>
                            </Grid.RowDefinitions>
                            <!-- 标题行：左标题 + 右「详细」开关 -->
                            <!-- 默认只显示日常必要信息（下载/解析/报错的
                                 结果），点「详细」才显示专业级（目录加载、缓存命中、连接分配、
                                 内部状态等过程细节）。按钮背景透明（GhostButton）。 -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 🚨 第 0 列必须**能被压缩**：原来是水平 StackPanel，
                                     两个 TextBlock 并排会按内容撑宽；一旦超过可用宽度，
                                     右侧 Auto 列（简要/详细、导出诊断包）就被顶到窗口外看不见。
                                     改成 Grid + 第 2 个 TextBlock 可裁剪，列宽才会让位。 -->
                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="运行日志"
                                               Style="{StaticResource SectionLabel}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                               Text="下载 / 解析 / 报错都会打在这里"
                                               FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>
                                <!-- 日志档位：两段式分段控件（简要 / 详细），
                                     与「分享链接 / 我的网盘」同一套滑块写法。
                                     🚨 2026-11-01（用户反馈「运行日志和详细都给改错了，
                                        其实它改好，变成以前那样」）：
                                     上一轮 XAML 恢复事故后，这里被我误改成了**单个 RadioButton**
                                     套 FilterTabRadio 样式 —— 那个样式是「下划线式页签」，
                                     单用会显得又大又偏、还没有"当前档位"的视觉表达。
                                     现在按原设计恢复成两段式（共用 LogThumb 滑块）。 -->
                                <Border Grid.Column="1" HorizontalAlignment="Left" CornerRadius="6"
                                        Background="{DynamicResource SurfaceSunkenBrush}"
                                        Padding="2" VerticalAlignment="Center">
                                    <Grid local:SegmentedSlider.IsEnabled="True"
                                          local:SegmentedSlider.Thumb="{x:Reference LogThumb}">
                                        <Border x:Name="LogThumb" CornerRadius="5" HorizontalAlignment="Left"
                                                VerticalAlignment="Stretch" IsHitTestVisible="False"
                                                Background="{DynamicResource SurfaceBrush}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LogBriefRadio" Content="简要"
                                                         Style="{StaticResource SegmentedRadio}"
                                                         FontSize="11" Padding="10,3" Margin="0"
                                                         IsChecked="True"
                                                         Checked="OnLogLevelChanged"/>
                                            <RadioButton x:Name="LogVerboseRadio" Content="详细"
                                                         Style="{StaticResource SegmentedRadio}"
                                                         FontSize="11" Padding="10,3" Margin="2,0,0,0"
                                                         Checked="OnLogLevelChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Button x:Name="DiagnosticsPackBtn" Grid.Column="2"
                                        Content="导出诊断包"
                                        Click="OnExportDiagnosticsPack"
                                        Style="{StaticResource GhostButton}"
                                        FontSize="11"
                                        Padding="8,3"
                                        Margin="6,0,0,0"
                                        ToolTip="把运行日志、环境信息与设置摘要打包成 zip，便于反馈问题。&#10;不包含账号 Cookie 与登录票据。"/>
                            </Grid>
                            <!-- 🚨 HorizontalAlignment=Stretch + ClipToBounds：
                                 日志框是 NoWrap，测量阶段会按最长行报告期望宽度，
                                 这个宽度会向上传递把整页撑得比窗口还宽，
                                 导致标题行右侧的「简要/详细」「导出诊断包」被推出窗口。
                                 Stretch 让它跟随父级宽度，ClipToBounds 裁掉超宽部分。 -->
                            <!-- 🚨🚨 2026-11-01（用户报「点下载页卡死」连带发现的布局炸弹）：
                                 日志框原来是 TextWrapping=NoWrap。WPF 的 TextBox 在**测量阶段**
                                 会按「最长的那一行」报告期望宽度，这个期望宽度会一路向上传递，
                                 把整个任务页 Grid 撑得比窗口还宽 ——
                                 于是标题行右侧的「简要/详细」「导出诊断包」被推出窗口看不见，
                                 日志框自己也超出右边界被裁掉。
                                 （ClipToBounds 只裁渲染、管不了测量，所以之前没用。）
                                 正解：**改成折行显示**。日志本来就是给人读的，
                                 横向滚动反而更难看清；折行后宽度完全由父级决定。 -->
                            <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource LogTextBox}"
                                     HorizontalAlignment="Stretch" ClipToBounds="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ============ 设置 ============ -->
                <TabItem Style="{StaticResource HeadlessTabItem}">
                    <!-- 与登录页同一处修正：ScrollViewer 默认 Left 会让内层对齐失效，
                         必须显式 Stretch；内层去掉 MaxWidth 才能真正撑满。 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"
                                  HorizontalContentAlignment="Stretch">
                        <!-- 外边距统一 24px（与下载页/任务页一致） -->
                        <StackPanel Margin="24,24,24,24" HorizontalAlignment="Stretch">

                            <TextBlock Text="设置" Style="{StaticResource PageTitleText}" Margin="0,0,0,4"/>
                            <TextBlock Text="所有改动即时生效，无需保存"
                                       Style="{StaticResource TertiaryText}" Margin="0,0,0,18"/>

                            <!-- ============ 多网盘账号（UC / 阿里 / 迅雷） ============
                                 ⚠️ 位置：**必须放在最前面**。
                                 原来放在两列网格之后，而设置页的设计目标是"一屏放下不滚动"，
                                 结果它被挤到可视区外 —— 用户打开设置页根本看不到（实测反馈）。
                                 放这里 = 打开设置页第一眼就是它。
                                 落盘时与夸克 Cookie 一样走 DPAPI 加密（见 SettingsStore）。
                                 ⚠️ 下面的 TextBox 命名被 ApplySettings 直接读取，改名要同步。 -->
                            <!-- 2026-11-01：去掉 MaxWidth，撑满可用宽度。 -->
                            <!-- 2026-11-01（用户拍板）：设置页这块「多网盘账号」整块删除。
                                 登录页已成为四家网盘的唯一入口，这里再放一份控件会造成
                                 x:Name 重复（编译报 CS0102），且用户要改两次才生效。 -->

                                <!-- ════════════════════════════════════════════════════════════
                                    设置页改为「一页平铺，不滚动」
                                    改前：5 个分类 Tab（外观 / 下载 / 窗口 / 存储 / 高级），
                                           一次只看一类，找设置要切来切去。
                                    改后：去掉分类 Tab，所有设置项**一页两列排平**，
                                           默认窗口尺寸（1240×780）下一屏看完、不需要滚动。
                                           共 6 张卡：个性化 / 下载与网络 / 窗口与后台 /
                                           存储 / 分片与缓存 / 播放器（原「高级」Tab 拆为后两张）。
                                    布局 = 两列各自堆叠（不是 Grid 行对齐）：
                                    行对齐会让「矮卡」浪费整行高度（存储卡 100 vs 窗口卡 210），
                                    列堆叠把高度差留在列内消化，两列总高 592 / 575，取大 592。
                                     ════════════════════════════════════════════════════════════ -->
                                <!-- 2026-11-01：去掉 MaxWidth，撑满可用宽度（与登录页一致）。 -->
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 两列各自堆叠 → **3 行 × 2 列行对齐**：
                                         每行两张卡等高（VerticalAlignment 默认 Stretch），两列底边自然齐平。
                                         代价：矮卡底部会留白（行高由该行较高的那张决定），这是行对齐的固有取舍。 -->
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 左列：下载与网络 → 窗口与后台 → 存储
                                         列堆叠（非行对齐）：行对齐时「矮卡」会浪费整行高度
                                         （存储卡 ~100 vs 窗口卡 ~210），列堆叠把高度差留在
                                         列内消化，两列总高 592 / 575，一屏放平不滚动。 -->

                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,14">
                                            <StackPanel>
                                                <TextBlock Text="下载与网络" Style="{StaticResource CardTitleText}"
                                                           FontSize="14" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="单文件并发连接数" Style="{StaticResource FieldLabel}"/>
                                                    <ComboBox x:Name="ThreadsBox" Grid.Column="1" MaxWidth="340"
                                                              HorizontalAlignment="Left"
                                                              Style="{StaticResource AppComboBox}"
                                                              ItemContainerStyle="{StaticResource AppComboBoxItem}"
                                                              SelectionChanged="OnSettingChanged">
                                                        <ComboBoxItem Content="16  — 省网保守"/>
                                                        <ComboBoxItem Content="32  — 保守，够用"/>
                                                        <!-- 标注必须与 Settings.Threads 的默认值一致。
                                                        默认值已按**实测拐点**从 64 改成 256
                                                        （docs/CDN并发阈值-实测.md：64 路 4.00 MB/s、128 路 7.98、
                                                        **256 路 13.94 ← 拐点**、512 路 13.31）。
                                                        ⚠️ 之前这里一直写着"64 — 默认"，与代码默认值不符，会直接误导用户。
                                                        ⚠️ 512 档：实测略慢于 256（13.31 vs 13.94），但那只是**当时那个时段**的
                                                        数据（CDN 配额会浮动），所以文案写"可能会更快"而不写死结论。 -->
                                                        <ComboBoxItem Content="64  — 省网，速度一般"/>
                                                        <ComboBoxItem Content="128 — 较快"/>
                                                        <ComboBoxItem Content="256 — 默认，实测最快"/>
                                                        <ComboBoxItem Content="512 — 上限，可能会更快"/>
                                                    </ComboBox>
                                                </Grid>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="机械盘连接上限" Style="{StaticResource FieldLabel}"
                                                               VerticalAlignment="Center"/>
                                                    <ComboBox x:Name="HddThreadsBox" Grid.Column="1" MaxWidth="340"
                                                              HorizontalAlignment="Left"
                                                              Style="{StaticResource AppComboBox}"
                                                              ItemContainerStyle="{StaticResource AppComboBoxItem}"
                                                              SelectionChanged="OnSettingChanged">
                                                        <ComboBoxItem Content="32  — 最护盘，速度较慢"/>
                                                        <ComboBoxItem Content="64  — 保守"/>
                                                        <ComboBoxItem Content="96  — 折中"/>
                                                        <ComboBoxItem Content="128 — 默认，推荐"/>
                                                        <ComboBoxItem Content="192 — 较快"/>
                                                        <ComboBoxItem Content="256 — 最快，寻道压力大"/>
                                                    </ComboBox>
                                                </Grid>

                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="同时下载任务数" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="ConcurrentBox" Grid.Column="1" MaxWidth="120"
                                                             HorizontalAlignment="Left"
                                                             Style="{StaticResource AppTextBox}"
                                                             LostFocus="OnSettingChanged"
                                                             KeyDown="OnSettingKeyDown"/>
                                                </Grid>

                                                <!-- 跟随系统代理。
                                                背景：程序历来**强制直连**（显式关闭代理，理由是
                                                本机代理软件会劫持夸克接口、代理会改变 TLS 指纹被 WAF 拒）。
                                                但"必须经代理才能上网"的环境（公司网络）里直连 = 程序
                                                完全不可用；而 QuarkSession 里那句 "可设 UseSystemProxy = true"
                                                此前**没有任何实现**（幽灵开关）。这里把它做成真设置项。
                                                ⚠️ 默认关闭 = 与旧版行为完全一致（零回归）。
                                                走独立 Click 处理器：不重建调度器（见 OnUseSystemProxyChanged）。 -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="代理" Style="{StaticResource FieldLabel}"/>
                                                    <CheckBox x:Name="UseSystemProxyCheck" Grid.Column="1"
                                                              Content="跟随 Windows 系统代理"
                                                              Style="{StaticResource AppCheckBox}"
                                                              Click="OnUseSystemProxyChanged"
                                                              AutomationProperties.Name="跟随系统代理"
                                                              ToolTip="默认关闭（直连）。公司网络 / 必须经代理才能上网时打开。本机装有代理软件（VPN、抓包、加速器）时建议保持关闭。"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource TertiaryText}" FontSize="11"
                                                           Margin="120,0,0,0" TextWrapping="Wrap"
                                                           Text="默认关闭（直连）。仅在必须经代理才能上网时打开；打开后重新开始下载或重新登录才会生效。"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,14">
                                            <StackPanel>
                                                <TextBlock Text="窗口与后台" Style="{StaticResource CardTitleText}"
                                                           FontSize="14" Margin="0,0,0,10"/>

                                                <!-- 关闭按钮行为 + 悬浮小窗入口。
                                                用户要求：第一次点 × 时询问「最小化到托盘 / 直接退出」，
                                                弹窗里可勾「此后不再提示」，之后在**这里**还能改。 -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="关闭按钮行为" Style="{StaticResource FieldLabel}"/>
                                                    <ComboBox x:Name="CloseActionBox" Grid.Column="1" MaxWidth="340"
                                                              HorizontalAlignment="Left"
                                                              Style="{StaticResource AppComboBox}"
                                                              ItemContainerStyle="{StaticResource AppComboBoxItem}"
                                                              SelectionChanged="OnSettingChanged">
                                                        <ComboBoxItem Content="每次询问"/>
                                                        <ComboBoxItem Content="最小化到托盘（后台继续下载）"/>
                                                        <ComboBoxItem Content="直接退出程序"/>
                                                    </ComboBox>
                                                </Grid>

                                                <!-- 剪贴板监听：复制网盘分享链接即自动解析（四家都认）。
                                                默认开；不想被打扰的用户在这里关掉。
                                                走独立的 Click 处理器（不是 OnSettingChanged）——
                                                这个开关不需要重建下载调度器，见 OnClipboardAutoParseChanged。 -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="剪贴板" Style="{StaticResource FieldLabel}"/>
                                                    <CheckBox x:Name="ClipboardAutoParseCheck" Grid.Column="1"
                                                              Content="复制分享链接时自动解析"
                                                              Style="{StaticResource AppCheckBox}"
                                                              Click="OnClipboardAutoParseChanged"
                                                              />
                                                </Grid>
                                                <TextBlock Style="{StaticResource TertiaryText}" FontSize="11"
                                                           Margin="120,0,0,0" TextWrapping="Wrap"
                                                           Text="窗口在托盘时静默解析，不抢焦点，解析完用托盘气泡提示结果。"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                                            <StackPanel>
                                                <TextBlock Text="存储" Style="{StaticResource CardTitleText}"
                                                           FontSize="14" Margin="0,0,0,10"/>

                                                <!-- 原来是 [120][*][Auto][Auto] 单行：
                                                     输入框被「浏览…」+「打开下载目录」两个按钮挤到只剩 ~60px，
                                                     只显示得出 "C://Users" 就被截断。
                                                     改成与右列「分片与缓存」完全同构的**竖排**：
                                                     标签在上、输入框吃满整行、两个按钮并排在右侧。 -->
                                                <TextBlock Text="下载目录" Style="{StaticResource FieldLabel}"
                                                           Margin="0,0,0,6"/>
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="OutDirBox" Grid.Column="0"
                                                             Style="{StaticResource AppTextBox}"
                                                             LostFocus="OnSettingChanged"
                                                             KeyDown="OnSettingKeyDown"/>
                                                    <Button Grid.Column="1" Content="浏览…"
                                                            Click="OnBrowseOutDir"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Margin="8,0,0,0"/>
                                                    <Button Click="OnOpenOutDir"
                                                            Grid.Column="2"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Margin="8,0,0,0"
                                                            ToolTip="在资源管理器中打开下载目录">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconFolder}" Stretch="Uniform"
                                                                  Width="14" Height="14" VerticalAlignment="Center"
                                                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                                                  StrokeThickness="1.8"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"/>
                                                            <TextBlock Text="打开" Margin="7,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <CheckBox x:Name="AutoCleanCheck"
                                                          Content="下载完成后自动清理云盘转存文件"
                                                          Style="{StaticResource AppCheckBox}"
                                                          Click="OnSettingChanged"/>
                                            </StackPanel>
                                        </Border>

                                    <!-- 右列：个性化 → 分片与缓存 → 播放器 -->

                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="个性化" Style="{StaticResource CardTitleText}"
                                                           FontSize="14" Margin="0,0,0,10"/>

                                                <Border HorizontalAlignment="Left" CornerRadius="8"
                                                        Background="{DynamicResource SurfaceSunkenBrush}"
                                                        Padding="3">
                                                    <Grid local:SegmentedSlider.IsEnabled="True"
                                                          local:SegmentedSlider.Thumb="{x:Reference ThemeThumb}">
                                                        <Border x:Name="ThemeThumb" CornerRadius="6"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Stretch"
                                                                IsHitTestVisible="False"
                                                                Background="{DynamicResource SurfaceBrush}"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton x:Name="ThemeLightRadio" Content="浅色"
                                                                         GroupName="AppTheme"
                                                                         Checked="OnThemeChanged"
                                                                         Style="{StaticResource SegmentedRadio}"
                                                                         AutomationProperties.Name="浅色主题"
                                                                         Margin="0"/>
                                                            <RadioButton x:Name="ThemeDarkRadio" Content="深色"
                                                                         GroupName="AppTheme"
                                                                         Checked="OnThemeChanged"
                                                                         Style="{StaticResource SegmentedRadio}"
                                                                         AutomationProperties.Name="深色主题"
                                                                         Margin="2,0,0,0"/>
                                                            <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统"
                                                                         GroupName="AppTheme"
                                                                         Checked="OnThemeChanged"
                                                                         Style="{StaticResource SegmentedRadio}"
                                                                         AutomationProperties.Name="跟随系统主题"
                                                                         Margin="2,0,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- 说明行：跟随系统时要让用户看懂"为什么我没选它却变了" -->
                                                <TextBlock x:Name="ThemeHintText"
                                                           Style="{StaticResource TertiaryText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,10,0,0"
                                                           Text="跟随系统时，Windows 切换深色/浅色，本程序会自动跟着变。"/>

                                                <!-- 主题版预览：让用户不用切来切去也能看到效果
                                                色块 34×22 → 40×40、圆角 5 → 8，
                                                并且**每个色块下方带自己的标签**（页面底 / 卡片 / 主色 / 正文）。
                                                改前只有末尾一行笼统的「当前配色的底色、卡片色、主色」——
                                                用户得数着猜哪个是哪个（"AI味"诊断里准确的一条：色块展示原始）。
                                                每个色块包成「色块 + 标签」的竖排小单元，间距 12px。 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <StackPanel Margin="0,0,12,0">
                                                        <Border Width="40" Height="40" CornerRadius="8"
                                                                Background="{DynamicResource AppBgBrush}"
                                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                                BorderThickness="1"/>
                                                        <TextBlock Text="页面底" Style="{StaticResource TertiaryText}"
                                                                   FontSize="11" HorizontalAlignment="Center"
                                                                   Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <Border Width="40" Height="40" CornerRadius="8"
                                                                Background="{DynamicResource SurfaceBrush}"
                                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                                BorderThickness="1"/>
                                                        <TextBlock Text="卡片" Style="{StaticResource TertiaryText}"
                                                                   FontSize="11" HorizontalAlignment="Center"
                                                                   Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <Border Width="40" Height="40" CornerRadius="8"
                                                                Background="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="主色" Style="{StaticResource TertiaryText}"
                                                                   FontSize="11" HorizontalAlignment="Center"
                                                                   Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <Border Width="40" Height="40" CornerRadius="8"
                                                                Background="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="正文" Style="{StaticResource TertiaryText}"
                                                                   FontSize="11" HorizontalAlignment="Center"
                                                                   Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 🚨 2026-11-01（用户拍板方案 B）：整块删掉「分片与缓存」卡。
                                             依据（五层架构全量 grep）：
                                               · DownloadJob.PartsRoot 只被赋值、从没被读取；
                                               · 融合引擎顺序写目标文件 + {目标}.geziresume，全程不建 .qparts；
                                               · PartsPaths.ResolvePaths 的唯一调用者是它自己（枚举历史残留用）。
                                             ⇒ 对当前下载行为零影响，留着只会让用户以为改它能提速/换盘。
                                             老用户旧目录残留仍可清 —— AllPartsRoots() 依然读
                                             Settings.PartsDirsKnown 这份历史清单。 -->

                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="播放器（边下边播用）"
                                                           Style="{StaticResource CardTitleText}"
                                                           FontSize="14" Margin="0,0,0,10"/>
                                                <TextBlock x:Name="PlayerStatusText" TextWrapping="Wrap"
                                                           Style="{StaticResource ProseText}" Margin="0,0,0,10"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="GetVlcBtn" Content="打开 VLC 下载页" Click="OnGetVlc"
                                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                                    <Button x:Name="RecheckPlayerBtn" Content="重新检测"
                                                            Click="OnRecheckPlayer" Style="{StaticResource SecondaryButton}"/>
                                                </StackPanel>

                                                <!-- 这里要介绍的是 **VLC**（本卡的主题是播放器），
                                                     不是鸽子下载自己。 -->
                                                <Border Margin="0,14,0,0" Padding="0,12,0,0"
                                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                                        BorderThickness="0,1,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="VLC media player · 开源全格式播放器"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="免费、开源（GPL-2.0+）、无广告、不联网也能用。几乎支持所有音视频格式与字幕；边下边播时以共享模式读取文件，不会干扰继续写盘。"
                                                                   FontSize="11" Margin="0,5,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ 登录 ============ -->
                <!-- 2026-11-01 重建：原登录 Tab 在恢复 git 版本时结构丢失，
                     这里按当前 C# 代码（MainWindow.Account.cs）实际引用的控件名重建：
                       Quark/Uc/Aliyun/Xunlei 四张卡 + PanStatusText/PanHintText
                       + 四个 *PastePanel（手动粘贴通栏）+ PanPasteRow/PanPasteLabel
                       + UcCookieBox / AliyunTokenBox / XunleiTokenBox
                       + *WebLoginBtn / *VerifyBtn / ImportCookieBtn / ImportCookieFileBtn
                     🚨 用户要求「填满整个空白地方」：
                       ScrollViewer 必须 HorizontalContentAlignment=Stretch（默认 Left 会让内层对齐失效），
                       StackPanel **不设 MaxWidth**（MaxWidth 本身就是留白来源）。 -->
                <TabItem Style="{StaticResource HeadlessTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"
                                  HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="24,24,24,24" HorizontalAlignment="Stretch">

                            <TextBlock Text="登录" Style="{StaticResource PageTitleText}" Margin="0,0,0,4"/>
                            <TextBlock Text="登录后可浏览「我的网盘」、转存分享文件；不登录也能用直链下载"
                                       Style="{StaticResource TertiaryText}" Margin="0,0,0,18"/>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="网盘账号"
                                                   Style="{StaticResource CardTitleText}"
                                                   FontSize="14" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="导出 Cookie"
                                                Click="OnExportCookies"
                                                Style="{StaticResource GhostButton}"
                                                FontSize="11" Padding="8,3"
                                                VerticalAlignment="Center"
                                                ToolTip="把选中的账号凭证打成一个 zip（按网盘分文件夹）"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource TertiaryText}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,14"
                                               Text="四家可同时登录。拿不到凭证时用「手动粘贴」。凭证只存在本机（DPAPI 加密），不外传。"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ① 夸克 -->
                                        <Border Grid.Column="0" Style="{StaticResource PanCard}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="夸克网盘" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="QuarkPanStatusText" Text="未登录"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                </Grid>
                                                <TextBlock x:Name="QuarkPanHintText" Text="扫码或内嵌登录"
                                                           FontSize="11" Margin="0,4,0,0"
                                                           LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Button Content="账号列表"
                                                        Click="OnOpenAccounts" Tag="Quark"
                                                        Style="{StaticResource SecondaryButton}"
                                                        FontSize="11" Padding="8,4" Margin="0,6,0,0"
                                                        HorizontalAlignment="Stretch"
                                                        ToolTip="查看已登录的账号，切换或移除"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="扫码登录"
                                                            Click="OnQuarkPanScan"
                                                            Style="{StaticResource SecondaryButton}"
                                                            FontSize="11" Padding="6,4"
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip="弹出二维码窗口，用手机夸克 App 扫码登录"/>
                                                    <Button Grid.Column="1" x:Name="QuarkWebLoginBtn"
                                                            Click="OnQuarkWebLogin"
                                                            Style="{StaticResource GhostButton}"
                                                            FontSize="11" Margin="6,0,0,0"
                                                            VerticalAlignment="Center" Content="内嵌登录"
                                                            ToolTip="在软件内打开夸克登录页，登录成功后自动获取凭证"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- ② UC -->
                                        <Border Grid.Column="1" Style="{StaticResource PanCardDivider}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="UC 网盘" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="UcPanStatusText" Text="未登录"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                </Grid>
                                                <TextBlock x:Name="UcPanHintText" Text="内嵌登录或粘贴 Cookie"
                                                           FontSize="11" Margin="0,4,0,0"
                                                           LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Button Content="账号列表"
                                                        Click="OnOpenAccounts" Tag="Uc"
                                                        Style="{StaticResource SecondaryButton}"
                                                        FontSize="11" Padding="8,4" Margin="0,6,0,0"
                                                        HorizontalAlignment="Stretch"
                                                        ToolTip="查看已登录的账号，切换或移除"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" x:Name="UcWebLoginBtn" Content="内嵌登录"
                                                            Click="OnUcWebLogin"
                                                            Style="{StaticResource SecondaryButton}"
                                                            FontSize="11" Padding="6,4"
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip="在软件内打开 UC 登录页"/>
                                                    <Button Grid.Column="1" Content="手动粘贴"
                                                            Click="OnTogglePanPaste" Tag="Uc"
                                                            Style="{StaticResource GhostButton}"
                                                            FontSize="11" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- ③ 阿里云盘 -->
                                        <Border Grid.Column="2" Style="{StaticResource PanCardDivider}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="阿里云盘" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="AliyunPanStatusText" Text="未登录"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                </Grid>
                                                <TextBlock x:Name="AliyunPanHintText" Text="内嵌登录或粘贴令牌"
                                                           FontSize="11" Margin="0,4,0,0"
                                                           LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Button Content="账号列表"
                                                        Click="OnOpenAccounts" Tag="Aliyun"
                                                        Style="{StaticResource SecondaryButton}"
                                                        FontSize="11" Padding="8,4" Margin="0,6,0,0"
                                                        HorizontalAlignment="Stretch"
                                                        ToolTip="查看已登录的账号，切换或移除"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" x:Name="AliyunWebLoginBtn" Content="内嵌登录"
                                                            Click="OnAliyunWebLogin"
                                                            Style="{StaticResource SecondaryButton}"
                                                            FontSize="11" Padding="6,4"
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip="在软件内打开阿里云盘登录页"/>
                                                    <Button Grid.Column="1" Content="手动粘贴"
                                                            Click="OnTogglePanPaste" Tag="Aliyun"
                                                            Style="{StaticResource GhostButton}"
                                                            FontSize="11" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- ④ 迅雷云盘 -->
                                        <Border Grid.Column="3" Style="{StaticResource PanCardDivider}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="迅雷云盘" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="XunleiPanStatusText" Text="未登录"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                </Grid>
                                                <TextBlock x:Name="XunleiPanHintText" Text="内嵌登录或粘贴令牌"
                                                           FontSize="11" Margin="0,4,0,0"
                                                           LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Button Content="账号列表"
                                                        Click="OnOpenAccounts" Tag="Xunlei"
                                                        Style="{StaticResource SecondaryButton}"
                                                        FontSize="11" Padding="8,4" Margin="0,6,0,0"
                                                        HorizontalAlignment="Stretch"
                                                        ToolTip="查看已登录的账号，切换或移除"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" x:Name="XunleiWebLoginBtn" Content="内嵌登录"
                                                            Click="OnXunleiWebLogin"
                                                            Style="{StaticResource SecondaryButton}"
                                                            FontSize="11" Padding="6,4"
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip="在软件内打开迅雷云盘登录页"/>
                                                    <Button Grid.Column="1" Content="手动粘贴"
                                                            Click="OnTogglePanPaste" Tag="Xunlei"
                                                            Style="{StaticResource GhostButton}"
                                                            FontSize="11" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 手动粘贴通栏（四家共用一行，一次只显示一块） -->
                                    <StackPanel x:Name="PanPasteRow" Visibility="Collapsed" Margin="0,14,0,0">
                                        <TextBlock x:Name="PanPasteLabel" FontSize="12" FontWeight="SemiBold"
                                                   Margin="0,0,0,6"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <StackPanel x:Name="QuarkPastePanel" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource TertiaryText}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                                       Text="登录 pan.quark.cn → F12 → Application → Cookies → 复制整串（__pus 与 __puus 都要有）"/>
                                        </StackPanel>
                                        <StackPanel x:Name="UcPastePanel" Visibility="Collapsed">
                                            <TextBox x:Name="UcCookieBox" Style="{StaticResource AppTextBox}"
                                                     LostFocus="OnSettingChanged" KeyDown="OnSettingKeyDown"
                                                     ToolTip="登录 drive.uc.cn 后按 F12 → Application → Cookies → 复制整串（含 __pus 与 __puus）"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button x:Name="UcVerifyBtn" Content="验证并登录"
                                                        Click="OnUcVerifyLogin"
                                                        Style="{StaticResource PrimaryButton}"
                                                        FontSize="11" Padding="12,5"/>
                                                <TextBlock x:Name="UcRuntimeStatusText" FontSize="11"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="AliyunPastePanel" Visibility="Collapsed">
                                            <TextBox x:Name="AliyunTokenBox" Style="{StaticResource AppTextBox}"
                                                     LostFocus="OnSettingChanged" KeyDown="OnSettingKeyDown"
                                                     ToolTip="登录 aliyundrive.com 后从 localStorage 取 refresh_token"/>
                                            <Button x:Name="AliyunVerifyBtn" Content="验证并登录"
                                                    Click="OnAliyunVerifyLogin"
                                                    Style="{StaticResource PrimaryButton}"
                                                    FontSize="11" Padding="12,5" Margin="0,8,0,0"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <StackPanel x:Name="XunleiPastePanel" Visibility="Collapsed">
                                            <TextBox x:Name="XunleiTokenBox" Style="{StaticResource AppTextBox}"
                                                     LostFocus="OnSettingChanged" KeyDown="OnSettingKeyDown"
                                                     ToolTip="粘贴迅雷云盘的 Bearer 令牌"/>
                                            <Button x:Name="XunleiVerifyBtn" Content="验证并登录"
                                                    Click="OnXunleiVerifyLogin"
                                                    Style="{StaticResource PrimaryButton}"
                                                    FontSize="11" Padding="12,5" Margin="0,8,0,0"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 当前状态（四家网盘各自的登录/容量，2026-11-01 重建）
                                 每行由 C# 的 BuildPanStateRow() 动态生成，这里只放容器。 -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="当前状态"
                                                   Style="{StaticResource CardTitleText}"
                                                   FontSize="14" VerticalAlignment="Center"/>
                                        <!-- 刷新中的转圈提示（RefreshPanStateList 控制可见性） -->
                                        <StackPanel x:Name="PanStateBusySpinner" Grid.Column="1"
                                                    Orientation="Horizontal" Visibility="Collapsed"
                                                    VerticalAlignment="Center">
                                            <Path x:Name="PanStateBusySpin" Data="{StaticResource IconRefresh}"
                                                  Stretch="Uniform" Width="12" Height="12"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.8"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock x:Name="PanStateBusyHint" Text="刷新中…"
                                                       FontSize="11" Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="PanStateList"/>
                                </StackPanel>
                            </Border>

                            <!-- 未完成任务入口（2026-11-01 重建）
                                 RefreshPendingEntry() 控制可见性与文案。 -->
                            <Button x:Name="PendingEntryBtn" Visibility="Collapsed"
                                    Click="OnOpenPendingEntry"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,14"
                                    Padding="12,7"
                                    ToolTip="上次没下完的任务，点这里继续">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Stretch="Uniform"
                                          Width="14" Height="14" VerticalAlignment="Center"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                    <TextBlock x:Name="PendingEntryText" Text="未完成 0" Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 导入 Cookie -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="导入 Cookie" Style="{StaticResource CardTitleText}"
                                               FontSize="14" Margin="0,0,0,10"/>
                                    <TextBox x:Name="CookieImportBox" Style="{StaticResource AppTextBox}"
                                             Margin="0,0,0,8"
                                             ToolTip="登录 pan.quark.cn 后按 F12 → Application → Cookies → 复制整串（__pus 与 __puus 都要有）"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ImportCookieBtn" Content="导入并登录"
                                                Click="OnImportCookie"
                                                Style="{StaticResource PrimaryButton}"
                                                FontSize="11" Padding="12,5"/>
                                        <Button x:Name="ImportCookieFileBtn" Content="从文件导入"
                                                Click="OnImportCookieFile"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="11" Padding="12,5" Margin="8,0,0,0"
                                                ToolTip="从文件读取 Cookie 并直接登录。&#10;支持 .txt（原始 Cookie 串）和 .json（浏览器扩展导出）。"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="小贴士" Style="{StaticResource CardTitleText}"
                                               FontSize="14" Margin="0,0,0,10"/>
                                    <TextBlock Style="{StaticResource ProseText}" TextWrapping="Wrap"
                                               Text="· 登录信息经系统加密后存在本地配置里，不会上传到任何服务器。"/>
                                    <TextBlock Style="{StaticResource ProseText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="· 登录状态过期时可以重新扫码：点夸克卡上的「扫码登录」获取新二维码。"/>
                                    <TextBlock Style="{StaticResource ProseText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="· 扫码得到的是网页版登录态，和手机 App 端互不影响、可同时使用。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                </TabControl>
            </Grid>

            <!-- 灵动岛（下载进度浮层，2026-11-01 重建）
                 C# 见 MainWindow.Island.cs：ShowIsland 控制显示，IslandShift 做上滑动画。 -->
            <Border x:Name="Island" Grid.Row="1" Grid.Column="1"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,12,0,0" Padding="14,8"
                    CornerRadius="14" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1"
                    Panel.ZIndex="100">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="IslandShift" Y="0"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{DynamicResource CapacityLowBrush}"/>
                    <TextBlock x:Name="IslandText" Text="" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ================= 解析历史 =================
                 盖住整窗（含标题栏），观感与「关于」这类浮层一致：**居中**一块卡片，
                 背后压暗；点面板外的暗色区域或按 Esc 关闭（见 OnMainKeyDown）。
                 独立窗口没法把"背后的主界面压暗"，
                 而这个面板要的正是"浮在当前界面之上"；在窗口里加一层 Grid 最直接。
                 列表内容由 RebuildHistoryPanel() 动态生成（分组标题 + 可点行）。
                 Focusable=True：打开时把焦点收到自己身上，免得之后随手敲的字母
                 钻进底下那个看不见的链接框里（会把链接改脏）。 -->
            <Grid x:Name="HistoryOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                  Focusable="True" FocusVisualStyle="{x:Null}">
                <!-- 遮罩：点它 = 关闭 -->
                <Border Background="{DynamicResource OverlayBrush}"
                        MouseLeftButtonDown="OnHistoryOverlayClick"/>

                <Border Width="580" MaxHeight="500"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 头：图标 + 标题 + 条数 + 「清空」 -->
                        <Grid Grid.Row="0" Margin="18,16,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHistory}" Stretch="Uniform"
                                      Width="17" Height="17" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                                <TextBlock Text="解析历史" Margin="9,0,0,0" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="HistoryCountText" Margin="9,0,0,0" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <!-- 右上角改为**关闭叉号**（原来这里是「清空」按钮，
                                 现在「清空」移到面板右下角）。 -->
                            <Button Grid.Column="1"
                                    Click="OnHistoryCloseClick"
                                    Style="{StaticResource IconGhostButton}"
                                    Width="28" Height="28" Focusable="False"
                                    AutomationProperties.Name="关闭解析历史"
                                    ToolTip="关闭">
                                <Path Data="{StaticResource IconClose}" Stretch="Uniform"
                                      Width="11" Height="11"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Button>
                        </Grid>

                        <!-- 列表（内容由 RebuildHistoryPanel 生成） -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Padding="10,0,10,12">
                            <StackPanel x:Name="HistoryListPanel"/>
                        </ScrollViewer>

                        <!-- 脚：左侧提示 + 右下角「清空」按钮
                             「清空」从右上角移到这里（右下角）。 -->
                        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                Padding="18,10,14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11" TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Text="点任意一条即可重新解析该分享 · 右键可置顶或删除 · 按 Esc、或点面板外的空白处关闭"/>
                                <Button Grid.Column="1" Content="清空"
                                        Click="OnHistoryClearClick"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,5" FontSize="12" Margin="12,0,0,0"
                                        ToolTip="清空全部解析历史"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
