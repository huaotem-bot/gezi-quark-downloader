                                                            <StackPanel Orientation="Horizontal">
                                                                <RadioButton x:Name="ThemeLightRadio" Content="浅色"
                                                                             GroupName="AppTheme"
                                                                             Checked="OnThemeChanged"
                                                                             Style="{StaticResource SegmentedRadio}"
                                                                             AutomationProperties.Name="浅色主题"
                                                                             Margin="0"/>
                                                                <RadioButton x:Name="ThemeDarkRadio" Content="深色"
                                                                             GroupName="AppTheme"
                                                                             Checked="OnThemeChanged"
                                                                             Style="{StaticResource SegmentedRadio}"
                                                                             AutomationProperties.Name="深色主题"
                                                                             Margin="2,0,0,0"/>
                                                                <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统"
                                                                             GroupName="AppTheme"
                                                                             Checked="OnThemeChanged"
                                                                             Style="{StaticResource SegmentedRadio}"
                                                                             AutomationProperties.Name="跟随系统主题"
                                                                             Margin="2,0,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <!-- 🚨 默认文案必须与 UpdateThemeHint() 里的「跟随系统」分支一致，
                                                         且必须**短到一行** —— 否则三种主题下外观卡高度不同，
                                                         右列底部会跟着上下跳（详见 MainWindow.Theme.cs 的注释）。 -->
                                                    <TextBlock x:Name="ThemeHintText"
                                                               Style="{StaticResource SettingsRowHint}"
                                                               Margin="0,7,0,0" MaxWidth="300"
                                                               HorizontalAlignment="Left"
                                                               Text="跟随系统自动切换"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Style="{StaticResource SettingsRow3}" Margin="0">
