                </TabItem>

                <!-- ============ 关于（2026-11-02 新增，2026-11-02 第三次重做） ============
                     用户要求：放在侧栏最后一项；点开在**右侧内容区**显示，不弹新窗口。
                     ⚠️ 它必须是**第 5 个 TabItem**（索引 4），与侧栏第 5 项严格对应，
                        否则 OnNavSelectionChanged 的索引同步会串页。

                     ============================================================
                     第三次重做（用户原话：「为什么总想着把所有东西写到一起，
                     你就不能分开有层次的写吗。居然还可以做更好做UI填满整个页面」）
                     ============================================================
                     前两版的共同毛病：**把所有内容堆进同样大小的卡片里**，
                     没有主次、没有层次，还留出大片空白。

                     这一版按「层次」组织，而不是按「卡片」组织：
                       ① **品牌区**（最高层）：应用图标 + 名字 + 版本徽章 + 一句话定位，
                          下面是两个主操作按钮。整块横跨全宽，做成醒目的横幅。
                       ② **数据条**：版本 / 作者 / 协议 / 状态 四个小格子并排 ——
                          这是"扫一眼就知道"的信息，不该用四行文字去读。
                       ③ **内容区**：使用教程（5 条，带序号徽章）与注意事项（4 条，带图标）
                          **并排两栏**，各自成块。这里是"读"的内容，分栏才不显得空。
                       ④ **底部条**：关注与反馈横跨全宽，链接按钮靠左，一句话靠右。

                     🚨 全宽 Stretch，**不设 MaxWidth** —— 上一版我加了 MaxWidth=760 + 左对齐，
                        结果窗口 1550px 只用了 760px，右边空掉 570px（43%），
                        用户截图里那片大空白就是这么来的。卡片列表就该撑满。
                     ============================================================ -->
                <TabItem Style="{StaticResource HeadlessTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"
                                  HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="20,18,20,16" HorizontalAlignment="Stretch">

                            <TextBlock Text="关于" Style="{StaticResource PageTitleText}" Margin="0,0,0,4"/>
                            <TextBlock Text="鸽子下载 —— 多网盘下载器"
                                       Style="{StaticResource TertiaryText}" Margin="0,0,0,14"/>

                            <!-- ==================== ① 品牌区（最高层） ====================
                                 整块横跨全宽、带背景与描边，是这一页的视觉焦点。
                                 左侧图标 + 中间名称/定位 + 右侧版本徽章与操作按钮。 -->
                            <!-- 🚨🚨 2026-11-04（第三次修，前两次都错了，原因写清楚免得再犯）：
                                 用户要求「检查更新的文案出现在卡内绿框位置，同时两个按钮永远居中不动」。
                                 前两次失败的原因：
                                   ① 文字和按钮同一个 StackPanel → 文字出现整块变高 → 按钮被顶走；
                                   ② 文字用 Margin 下移"绝对定位"到同一 Grid 行 →
                                      **Grid 行高 = 该列所有子元素的最大占用高度**，
                                      文字带 60px 上边距后占 92px > 按钮 34px，
                                      行高从 34 涨到 92 → 卡片变高 → 按钮照样被挤。
                                 ⇒ 只要文字还在**参与布局计算**，它变高就一定会推走按钮。
                                 ⇒ 正解：**把卡片高度钉死**（Height=120，与当前实际高度一致，视觉无变化）。
                                    · 按钮 VerticalAlignment=Center → 永远在卡片正中，像素级不动；
                                    · 文案 VerticalAlignment=Bottom + 单行 NoWrap →
                                      永远贴着卡底（用户画的绿框位置），最多省略号 + ToolTip 看全文。
                                    两个元素的高度从此都是常量，互不影响。 -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12"
                                    Height="120" Padding="22,18" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 应用图标：48px，带浅底圆角，比纯图标更有"产品感" -->
                                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14"
                                            Background="{DynamicResource SurfaceSunkenBrush}"
                                            BorderBrush="{DynamicResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Image Source="/Resources/app-logo.png" Width="40" Height="40"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- 名称 + 一句话定位 -->
                                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="鸽子下载" FontSize="20" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Border Margin="10,0,0,0" CornerRadius="4" Padding="7,2"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource SurfaceSunkenBrush}">
                                                <TextBlock x:Name="AboutVersionBadge" Text="v?"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="夸克 · UC · 阿里云盘 · 迅雷云盘 —— 一个界面全搞定"
                                                   FontSize="12.5" Margin="0,7,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>

                                    <!-- 按钮：垂直居中于固定 120 高的卡片 → y 恒等于 60，永久不动 -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="检查更新" Click="OnAboutCheckUpdate"
                                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                            <Button Content="赞赏支持" Click="OnAboutReward"
                                                    Style="{StaticResource SecondaryButton}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 检查更新结果：钉在卡片底部右侧（用户指定的绿框位置）。
                                         单行 + 省略号 + ToolTip 看全文 —— 高度恒为一行，
                                         既不会撑高卡片，也不会和上面的按钮重叠。 -->
                                    <TextBlock x:Name="AboutUpdateStatusText" Grid.Column="2"
                                               VerticalAlignment="Bottom"
                                               HorizontalAlignment="Right" TextAlignment="Right"
                                               FontSize="11.5" Margin="0,0,0,0"
                                               MaxWidth="260" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="Collapsed"
                                               ToolTipService.ShowDuration="20000"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>
                            </Border>

                            <!-- ==================== ② 数据条（扫一眼就知道） ====================
                                 四个等宽小格子并排，替代原来「四行文字」的读法。
                                 这一层是"信息密度"，不是"阅读内容"，所以格子要小、要横排。 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SettingsCard}" Padding="16,14" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="版本" FontSize="11.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock x:Name="AboutVersionText" Text="v?" FontSize="15" FontWeight="SemiBold"
                                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource SettingsCard}" Padding="16,14" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="作者" FontSize="11.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="Yi Yuan" FontSize="15" FontWeight="SemiBold"
                                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource SettingsCard}" Padding="16,14" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="开源协议" FontSize="11.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="AGPL-3.0" FontSize="15" FontWeight="SemiBold"
                                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource SettingsCard}" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="隐私" FontSize="11.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="无广告 · 无遥测" FontSize="15" FontWeight="SemiBold"
                                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ==================== ③ 内容区（两栏并排） ====================
                                 使用教程与注意事项并排：这两块是"读"的内容，
                                 并排才不显得空，也让页面在宽窗口下被填满。
                                 ⚠️ 两栏都用 * 等宽，不设固定宽度 —— 窗口变宽时一起变宽。 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 使用教程：每条带序号徽章，形成清晰的步骤层次 -->
                                <Border Grid.Column="0" Style="{StaticResource SettingsCard}"
                                        Margin="0,0,12,0" Padding="18,16">
                                    <StackPanel>
                                        <Grid Style="{StaticResource SettingsCardHeader}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconFileText}" Stretch="Uniform"
                                                      Width="16" Height="16" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.7"/>
                                                <TextBlock Text="使用教程" Style="{StaticResource SettingsCardTitle}"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 步骤行：左边 20px 圆底序号，右边正文 -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                                    VerticalAlignment="Top" Margin="0,1,0,0"
                                                    Background="{DynamicResource SurfaceSunkenBrush}">
                                                <TextBlock Text="1" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Style="{StaticResource ProseText}" TextWrapping="Wrap">
                                                <Run Text="下载分享文件：把网盘分享链接粘到「下载」页的输入框，点「解析」，选中文件后点「下载」。"/>
                                            </TextBlock>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                                    VerticalAlignment="Top" Margin="0,1,0,0"
                                                    Background="{DynamicResource SurfaceSunkenBrush}">
                                                <TextBlock Text="2" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Style="{StaticResource ProseText}" TextWrapping="Wrap">
                                                <Run Text="多选文件：在文件列表里按住"/>
                                                <Run Text="Shift" FontWeight="SemiBold"/>
                                                <Run Text="再点另一项连续多选；按住"/>
                                                <Run Text="Ctrl" FontWeight="SemiBold"/>
                                                <Run Text="可点选多个不连续的文件。"/>
                                            </TextBlock>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                                    VerticalAlignment="Top" Margin="0,1,0,0"
                                                    Background="{DynamicResource SurfaceSunkenBrush}">
                                                <TextBlock Text="3" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Style="{StaticResource ProseText}" TextWrapping="Wrap">
                                                <Run Text="免转存下载：在文件上点"/>
                                                <Run Text="右键" FontWeight="SemiBold"/>
                                                <Run Text="，选「免转存下载」—— 不写入你的网盘，直接从分享取链（仅夸克 / UC 支持）。"/>
                                            </TextBlock>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                                    VerticalAlignment="Top" Margin="0,1,0,0"
                                                    Background="{DynamicResource SurfaceSunkenBrush}">
                                                <TextBlock Text="4" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Style="{StaticResource ProseText}" TextWrapping="Wrap">
                                                <Run Text="浏览自己的网盘：登录后切到「我的网盘」，四家网盘可随时切换，不用重新登录。"/>
                                            </TextBlock>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                                    VerticalAlignment="Top" Margin="0,1,0,0"
                                                    Background="{DynamicResource SurfaceSunkenBrush}">
                                                <TextBlock Text="5" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Style="{StaticResource ProseText}" TextWrapping="Wrap">
                                                <Run Text="断点续传：任务暂停或软件重启后，在「任务」页右上角的「未完成」入口可以接着下，已下载的部分不会重下。"/>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 注意事项：每条前一个警示小点，语气是"提醒"不是"步骤" -->
                                <Border Grid.Column="1" Style="{StaticResource SettingsCard}" Padding="18,16">
                                    <StackPanel>
                                        <Grid Style="{StaticResource SettingsCardHeader}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconWarning}" Stretch="Uniform"
                                                      Width="16" Height="16" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.7"/>
                                                <TextBlock Text="注意事项" Style="{StaticResource SettingsCardTitle}"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="5" Height="5" Margin="0,7,0,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Style="{StaticResource ProseText}" TextWrapping="Wrap">
                                                <Run Text="登录凭据仅以 Windows DPAPI 加密保存在本机，"/>
                                                <Run Text="不会上传到任何服务器" FontWeight="SemiBold"/>
                                                <Run Text="，也不含任何遥测。"/>
                                            </TextBlock>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="5" Height="5" Margin="0,7,0,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Style="{StaticResource ProseText}" TextWrapping="Wrap">
                                                <Run Text="阿里云盘 / 迅雷云盘下载分享文件时，"/>
                                                <Run Text="必须先转存到自己网盘" FontWeight="SemiBold"/>
                                                <Run Text="才能取到直链；任务结束会自动清理这份临时转存。"/>
                                            </TextBlock>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="5" Height="5" Margin="0,7,0,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Style="{StaticResource ProseText}" TextWrapping="Wrap">
                                                <Run Text="免转存（游客直链）只能下夸克原本就允许的 ≤10MB 小文件，大文件仍需登录。"/>
                                            </TextBlock>
                                        </Grid>

                                        <!-- 2026-11-04：用户要求「卡片下方大片空白，多写有用的字，不要水」。
                                             下面四条全部来自 AGENTS.md 的实测记录与代码实际行为，
                                             每条都能解释用户真实会遇到的疑惑。 -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="5" Height="5" Margin="0,7,0,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Style="{StaticResource ProseText}" TextWrapping="Wrap">
                                                <Run Text="下载速度取决于网盘对单 IP 的限速，与软件本身关系不大。"/>
                                                <Run Text="夸克实测最快，迅雷单 IP 上限 16 连接。" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="5" Height="5" Margin="0,7,0,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Style="{StaticResource ProseText}" TextWrapping="Wrap">
                                                <Run Text="暂停或重启后进度不会丢：分片记录在本地，会从断点继续，已下载的部分不会重下。"/>
                                            </TextBlock>
                                        </Grid>

                                        <!-- 收尾一条：放在最后，与上面几条保持同样的圆点样式 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="5" Height="5" Margin="0,7,0,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Style="{StaticResource ProseText}" TextWrapping="Wrap">
                                                <Run Text="本软件仅供个人学习与备份使用，请遵守各网盘的服务条款与当地法律法规。"/>
                                            </TextBlock>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ==================== ④ 底部条（横跨全宽） ====================
                                 左侧是入口按钮，右侧是一句话 —— 一行铺满，不留空白。 -->
                            <Border Style="{StaticResource SettingsCard}" Padding="20,14" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconLink}" Stretch="Uniform"
                                              Width="16" Height="16" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.7"/>
                                        <TextBlock Text="关注与反馈" Style="{StaticResource SettingsCardTitle}"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0"
                                                VerticalAlignment="Center">
                                        <Button Content="开源地址" Click="OnAboutGithub"
                                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                        <Button Content="作者 B 站" Click="OnAboutBilibili"
                                                Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               FontSize="11.5" TextWrapping="Wrap" MaxWidth="360"
                                               HorizontalAlignment="Right" TextAlignment="Right"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="发现问题或有建议，欢迎在 GitHub 提 Issue"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                </TabControl>
            </Grid>

            <!-- 灵动岛（下载进度浮层，2026-11-01 重建）
                 C# 见 MainWindow.Island.cs：ShowIsland 控制显示，IslandShift 做上滑动画。 -->
            <Border x:Name="Island" Grid.Row="1" Grid.Column="1"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,12,0,0" Padding="14,8"
                    CornerRadius="14" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1"
                    Panel.ZIndex="100">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="IslandShift" Y="0"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{DynamicResource CapacityLowBrush}"/>
                    <TextBlock x:Name="IslandText" Text="" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ================= 解析历史 =================
                 盖住整窗（含标题栏），观感与「关于」这类浮层一致：**居中**一块卡片，
                 背后压暗；点面板外的暗色区域或按 Esc 关闭（见 OnMainKeyDown）。
                 独立窗口没法把"背后的主界面压暗"，
                 而这个面板要的正是"浮在当前界面之上"；在窗口里加一层 Grid 最直接。
                 列表内容由 RebuildHistoryPanel() 动态生成（分组标题 + 可点行）。
                 Focusable=True：打开时把焦点收到自己身上，免得之后随手敲的字母
                 钻进底下那个看不见的链接框里（会把链接改脏）。 -->
            <Grid x:Name="HistoryOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                  Focusable="True" FocusVisualStyle="{x:Null}">
                <!-- 遮罩：点它 = 关闭 -->
                <Border Background="{DynamicResource OverlayBrush}"
                        MouseLeftButtonDown="OnHistoryOverlayClick"/>

                <Border Width="580" MaxHeight="500"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 头：图标 + 标题 + 条数 + 「清空」 -->
                        <Grid Grid.Row="0" Margin="18,16,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHistory}" Stretch="Uniform"
                                      Width="17" Height="17" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                                <TextBlock Text="解析历史" Margin="9,0,0,0" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="HistoryCountText" Margin="9,0,0,0" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <!-- 右上角改为**关闭叉号**（原来这里是「清空」按钮，
                                 现在「清空」移到面板右下角）。 -->
                            <Button Grid.Column="1"
                                    Click="OnHistoryCloseClick"
                                    Style="{StaticResource IconGhostButton}"
                                    Width="28" Height="28" Focusable="False"
                                    AutomationProperties.Name="关闭解析历史"
                                    ToolTip="关闭">
                                <Path Data="{StaticResource IconClose}" Stretch="Uniform"
                                      Width="11" Height="11"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Button>
                        </Grid>

                        <!-- 列表（内容由 RebuildHistoryPanel 生成）
                             🚨 2026-11-01：滚动到底部时**分批追加**下一批
                             （见 OnHistoryScrollChanged / RevealNextHistoryBatch）。
                             原来一次性把几百条行 + 分组标题全塞进 StackPanel，
                             打开面板要卡一下；目录列表早就是分批的，这里对齐它。 -->
                        <ScrollViewer x:Name="HistoryScroll"
                                      Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="OnHistoryScrollChanged"
                                      Padding="10,0,10,12">
                            <StackPanel x:Name="HistoryListPanel"/>
                        </ScrollViewer>

                        <!-- 脚：左侧提示 + 右下角「清空」按钮
                             「清空」从右上角移到这里（右下角）。 -->
                        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                Padding="18,10,14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11" TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Text="点任意一条即可重新解析该分享 · 右键可置顶或删除 · 按 Esc、或点面板外的空白处关闭"/>
                                <Button Grid.Column="1" Content="清空"
                                        Click="OnHistoryClearClick"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,5" FontSize="12" Margin="12,0,0,0"
                                        ToolTip="清空全部解析历史"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
